# Моя первая программа на языке «Понятный»
пусть имя = спроси("Как тебя зовут?")
напиши "Привет, " + имя + "!"

напиши "Считаю до пяти:"
пусть i = 1
пока i <= 5
    напиши i
    i = i + 1
конец

функция квадрат(x)
    верни x * x
конец

напиши "Таблица умножения на 7:"
для каждого n из от(1, 10)
    напиши "7 ×", n, "=", 7 * n
конец

пусть числа = [3, 8, 1, 9, 4]
пусть сумма = 0
для каждого ч из числа
    сумма = сумма + ч
конец
напиши "Сумма списка:", сумма
напиши "Квадрат девяти:", квадрат(9)

если сумма > 20 то
    напиши "Сумма больше двадцати"
иначе
    напиши "Сумма небольшая"
конец

повторить 3 раз
    напиши "Ура!"
конец
