# Новые возможности: конвейер, шаблоны, когда, ?., навсегда
пусть текст = "   ПрИвЕт, МиР   "
напиши текст затем обрезать затем маленькими
напиши текст |> обрезать |> длина

пусть имя = "Ваня"
напиши "Привет, {имя}! В имени {длина(имя)} буквы."

функция размер(n)
    выбор n
        вариант 0
            верни "ноль"
        вариант 1, 2, 3
            верни "мало"
        когда x если x > 100 то
            верни "очень много"
        иначе
            верни "нормально"
    конец
конец
для каждого n из [0, 2, 50, 500]
    напиши n, "—", размер(n)
конец

пусть покупатель = ничего
напиши "Заказ:", покупатель?.заказ
покупатель?.заказ = 5
пусть клиент = {имя: "Оля", заказ: {номер: 42}}
напиши "Номер заказа:", клиент?.заказ?.номер

пусть навсегда дни = ["пн", "вт", "ср"]
попробуй
    дни.добавь("чт")
если ошибка как е
    напиши "Нельзя:", е
конец
