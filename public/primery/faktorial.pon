# Рекурсия: факториал и числа Фибоначчи
функция факториал(н: число) -> число
    если н <= 1 то
        верни 1
    конец
    верни н * факториал(н - 1)
конец

функция фибоначчи(н)
    если н < 2 то
        верни н
    конец
    верни фибоначчи(н - 1) + фибоначчи(н - 2)
конец

для i от 1 до 10
    пиши "{i}! = {факториал(i)}"
конец

пусть ряд = []
для i от 0 до 15
    ряд.добавь(фибоначчи(i))
конец
пиши "Фибоначчи:", ряд
