# Моя первая программа на языке «Понятный»
пусть имя = спроси("Как тебя зовут?")
пиши "Привет, " + имя + "!"

пиши "Считаю до пяти:"
пусть i = 1
пока i <= 5
    пиши i
    i = i + 1
конец

функция квадрат(x)
    верни x * x
конец

пиши "Таблица умножения на 7:"
для каждого n из от(1, 10)
    пиши "7 ×", n, "=", 7 * n
конец

пусть числа = [3, 8, 1, 9, 4]
пусть сумма = 0
для каждого ч из числа
    сумма = сумма + ч
конец
пиши "Сумма списка:", сумма
пиши "Квадрат девяти:", квадрат(9)

если сумма > 20 то
    пиши "Сумма больше двадцати"
иначе
    пиши "Сумма небольшая"
конец

повторить 3 раз
    пиши "Ура!"
конец
