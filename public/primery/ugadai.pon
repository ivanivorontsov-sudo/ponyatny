# Угадай число от 1 до 100
пусть загадано = случайное(1, 100)
пусть попыток = 0
пиши "Я загадал число от 1 до 100. Угадай!"
пока истина
    пусть ответ = спроси("Твой вариант:")
    если ответ == "" то
        пиши "Ты не ввёл число. Было загадано {загадано}"
        стоп
    конец
    попыток += 1
    попробуй
        пусть n = число(ответ)
        если n < загадано то
            пиши "Больше!"
        иначе если n > загадано то
            пиши "Меньше!"
        иначе
            пиши "Угадал за {попыток} попыток!"
            стоп
        конец
    если ошибка
        пиши "Это не число, попробуй ещё раз"
    конец
    если попыток >= 10 то
        пиши "Попытки кончились. Было загадано {загадано}"
        стоп
    конец
конец
