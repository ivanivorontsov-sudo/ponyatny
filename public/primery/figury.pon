# Интерфейсы, общие и скрытые члены, свойства (Понятный 2.4)
интерфейс Фигура                     # список функций, которые обязан иметь класс
    функция площадь()
    функция имя() -> строка
конец

класс Фигура2Д
    абстрактная функция площадь()    # без тела: её пишет наследник
конец

класс Квадрат наследует Фигура2Д реализует Фигура
    общая пусть создано = 0          # поле класса, а не объекта (static)
    скрытая пусть сторона = 0        # снаружи класса недоступно (проверяется при компиляции)
    функция создать(с)
        это.сторона = с
        Квадрат.создано += 1
    конец
    функция площадь()
        верни это.сторона ^ 2
    конец
    функция имя()
        верни "квадрат"
    конец
    свойство периметр                # читается как поле: к.периметр
        верни 4 * это.сторона
    конец
    общая функция единичный()        # вызывается у класса: Квадрат.единичный()
        верни Квадрат(1)
    конец
конец

пусть к = Квадрат.единичный()
пиши к.площадь(), к.периметр, Квадрат.создано
пиши экземпляр(к, Фигура), экземпляр(к, Квадрат), экземпляр(5, "число")
