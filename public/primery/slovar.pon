# Словари: оценки учеников
пусть оценки = {"Ваня": 5, "Маша": 4, "Петя": 3}
оценки["Оля"] = 5

для каждого имя, балл из оценки
    напиши "{имя}: {балл}"
конец

пусть отличники = []
для каждого имя из оценки.ключи()
    если оценки[имя] == 5 то
        отличники.добавь(имя)
    конец
конец
напиши "Отличники:", отличники.соедини(", ")
напиши "Средний балл:", сумма(оценки.значения()) / оценки.длина
напиши "Есть Петя?", "Петя" в оценки
оценки.убери("Петя")
напиши "Учеников осталось:", длина(оценки)

пусть слова = "кот пёс кот ёж пёс кот".разделить(" ")
пусть счёт = {}
для каждого с из слова
    счёт[с] = счёт.получи(с, 0) + 1
конец
напиши счёт
