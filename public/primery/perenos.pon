# Перенос длинных строк (2.7) и слова с любой первой буквой
пусть цены = [120, 45,
              300, 15]
пусть итого = сумма(цены) \
    + 100
пиши "Итого:", итого
пусть имя = "  ВАСЯ  "
    .обрезать()
    .маленькими()
    .с_заглавной()
пиши имя
если итого > 100
    и длина(цены) == 4 то
    пиши "Длинное условие на двух строках работает"
конец
попробуй
    брось ошибка("Ошибка с маленькой буквы")
если ошибка ошибка как е
    пиши "Поймали:", е
конец
пиши "пи =", округли(пи, 5)
