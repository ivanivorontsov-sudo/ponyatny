# Калькулятор: спрашивает два числа и действие
пусть a = число(спроси("Первое число:"))
пусть b = число(спроси("Второе число:"))
пусть действие = спроси("Действие (+, -, *, /):")

функция посчитать(x, y, знак)
    выбор знак
        вариант "+"
            верни x + y
        вариант "-"
            верни x - y
        вариант "*", "×"
            верни x * y
        вариант "/"
            если y == 0 то
                брось "на ноль делить нельзя"
            конец
            верни x / y
        иначе
            брось "не знаю действие «{знак}»"
    конец
конец

попробуй
    пиши "{a} {действие} {b} = {посчитать(a, b, действие)}"
если ошибка как е
    пиши "Не получилось:", е
конец
