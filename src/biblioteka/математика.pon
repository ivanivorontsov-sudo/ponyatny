# стд/математика — полезные математические функции
функция факториал(н)
    пусть итог = 1
    для i от 2 до н
        итог *= i
    конец
    верни итог
конец

функция нод(a, b)
    a = модуль(a)
    b = модуль(b)
    пока b != 0
        пусть остаток = a % b
        a = b
        b = остаток
    конец
    верни a
конец

функция нок(a, b)
    если a == 0 или b == 0 то
        верни 0
    конец
    верни модуль(a * b) / нод(a, b)
конец

функция простое(н)
    если н < 2 то
        верни ложь
    конец
    пусть д = 2
    пока д * д <= н
        если н % д == 0 то
            верни ложь
        конец
        д += 1
    конец
    верни истина
конец

функция среднее(список_чисел)
    если длина(список_чисел) == 0 то
        верни 0
    конец
    верни сумма(список_чисел) / длина(список_чисел)
конец

функция медиана(список_чисел)
    пусть с = список_чисел.отсортировано()
    пусть н = длина(с)
    если н == 0 то
        верни 0
    конец
    если н % 2 == 1 то
        верни с[целое(н / 2)]
    конец
    верни (с[н / 2 - 1] + с[н / 2]) / 2
конец

функция процент(часть, целое_число)
    если целое_число == 0 то
        верни 0
    конец
    верни часть * 100 / целое_число
конец

функция ограничь(x, наименьшее, наибольшее)
    если x < наименьшее то
        верни наименьшее
    конец
    если x > наибольшее то
        верни наибольшее
    конец
    верни x
конец

функция в_радианы(градусы)
    верни градусы * ПИ / 180
конец

функция в_градусы(радианы)
    верни радианы * 180 / ПИ
конец

функция чётное(н)
    верни н % 2 == 0
конец
