# стд/вектор — двумерные векторы для игр и графики
# Перевод основных методов библиотеки Victor.js (© 2011 Max Kueng, George Crabtree, лицензия MIT).

класс Вектор
    пусть x = 0
    пусть y = 0

    функция создать(x = 0, y = 0)
        это.x = x
        это.y = y
    конец

    функция плюс(другой)
        верни Вектор(это.x + другой.x, это.y + другой.y)
    конец

    функция минус(другой)
        верни Вектор(это.x - другой.x, это.y - другой.y)
    конец

    функция умножь(число_раз)
        верни Вектор(это.x * число_раз, это.y * число_раз)
    конец

    функция раздели(делитель)
        если делитель == 0 то
            брось "Вектор нельзя делить на ноль"
        конец
        верни Вектор(это.x / делитель, это.y / делитель)
    конец

    функция длина_вектора()
        верни корень(это.x * это.x + это.y * это.y)
    конец

    функция единичный()
        пусть д = это.длина_вектора()
        если д == 0 то
            верни Вектор(0, 0)
        конец
        верни Вектор(это.x / д, это.y / д)
    конец

    функция скалярно(другой)
        верни это.x * другой.x + это.y * другой.y
    конец

    функция векторно(другой)
        верни это.x * другой.y - это.y * другой.x
    конец

    функция расстояние(другой)
        пусть дх = это.x - другой.x
        пусть ду = это.y - другой.y
        верни корень(дх * дх + ду * ду)
    конец

    функция угол()
        верни арктангенс(это.y, это.x)
    конец

    функция повёрнутый(угол_поворота)
        пусть кс = косинус(угол_поворота)
        пусть сн = синус(угол_поворота)
        верни Вектор(это.x * кс - это.y * сн, это.x * сн + это.y * кс)
    конец

    функция ограниченный(наибольшая_длина)
        пусть д = это.длина_вектора()
        если д > наибольшая_длина и д > 0 то
            верни это.умножь(наибольшая_длина / д)
        конец
        верни Вектор(это.x, это.y)
    конец

    функция смесь(другой, доля)
        верни Вектор(это.x + (другой.x - это.x) * доля, это.y + (другой.y - это.y) * доля)
    конец

    функция копия_вектора()
        верни Вектор(это.x, это.y)
    конец

    функция строкой()
        верни "(" + строка(это.x) + "; " + строка(это.y) + ")"
    конец
конец

функция вектор_из_угла(угол, длина_вектора = 1)
    верни Вектор(косинус(угол) * длина_вектора, синус(угол) * длина_вектора)
конец
