# стд/случай — случайные числа и выбор
функция случайный_элемент(список_значений)
    если длина(список_значений) == 0 то
        верни ничего
    конец
    верни список_значений[случайное(0, длина(список_значений) - 1)]
конец

функция перемешай(список_значений)
    пусть с = список_значений.копия()
    для i от длина(с) - 1 до 1
        пусть j = случайное(0, i)
        пусть врем = с[i]
        с[i] = с[j]
        с[j] = врем
    конец
    верни с
конец

функция кубик(граней = 6)
    верни случайное(1, граней)
конец

функция монетка()
    верни если случайное(0, 1) == 0 то "орёл" иначе "решка"
конец

функция пароль(длина_пароля = 10)
    пусть знаки = "abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789"
    пусть итог = ""
    повторить длина_пароля раз
        итог = итог + знаки[случайное(0, длина(знаки) - 1)]
    конец
    верни итог
конец

функция с_вероятностью(процентов)
    верни случайное() * 100 < процентов
конец
