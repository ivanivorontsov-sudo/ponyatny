# стд/поиск — двоичный поиск в отсортированном списке
# Перевод модуля bisect из стандартной библиотеки Python 3.12 (© Python Software Foundation, лицензия PSF-2.0).

функция место_слева(список_значений, значение, низ = 0, верх = -1)
    # bisect_left: первое место, куда можно вставить значение, не нарушив порядок
    если верх < 0 то
        верх = длина(список_значений)
    конец
    пока низ < верх
        пусть середина = нацело(низ + верх, 2)
        если список_значений[середина] < значение то
            низ = середина + 1
        иначе
            верх = середина
        конец
    конец
    верни низ
конец

функция место_справа(список_значений, значение, низ = 0, верх = -1)
    # bisect_right: последнее такое место
    если верх < 0 то
        верх = длина(список_значений)
    конец
    пока низ < верх
        пусть середина = нацело(низ + верх, 2)
        если значение < список_значений[середина] то
            верх = середина
        иначе
            низ = середина + 1
        конец
    конец
    верни низ
конец

функция вставь_по_порядку(список_значений, значение)
    # insort_right
    список_значений.вставь(место_справа(список_значений, значение), значение)
    верни список_значений
конец

функция найди_двоичным(список_значений, значение)
    # номер значения в отсортированном списке или -1
    пусть м = место_слева(список_значений, значение)
    если м < длина(список_значений) и список_значений[м] == значение то
        верни м
    конец
    верни -1
конец
