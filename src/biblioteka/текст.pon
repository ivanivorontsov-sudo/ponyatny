# стд/текст — перенос и выравнивание абзацев
# Перевод основных функций модуля textwrap из стандартной библиотеки Python 3.12
# (© Python Software Foundation, лицензия PSF-2.0): wrap, fill, shorten, dedent, indent.

функция перенеси(текст, ширина = 70)
    # wrap: список строк не длиннее «ширина»
    если ширина < 1 то
        брось "Ширина строки должна быть не меньше 1"
    конец
    пусть слова_текста = строка(текст).разделить()
    пусть строки_итога = []
    пусть текущая = ""
    для каждого слово из слова_текста
        пока длина(слово) > ширина
            если текущая != "" то
                строки_итога.добавь(текущая)
                текущая = ""
            конец
            строки_итога.добавь(слово.срез(0, ширина))
            слово = слово.срез(ширина)
        конец
        если текущая == "" то
            текущая = слово
        иначе если длина(текущая) + 1 + длина(слово) <= ширина то
            текущая += " " + слово
        иначе
            строки_итога.добавь(текущая)
            текущая = слово
        конец
    конец
    если текущая != "" то
        строки_итога.добавь(текущая)
    конец
    верни строки_итога
конец

функция абзац(текст, ширина = 70)
    # fill: то же, что «перенеси», одной строкой с переводами строк
    верни соедини(перенеси(текст, ширина), "\n")
конец

функция сократи(текст, ширина, заполнитель = " […]")
    # shorten: схлопывает пробелы и обрезает по словам
    пусть слова_текста = строка(текст).разделить()
    пусть целиком = соедини(слова_текста, " ")
    если длина(целиком) <= ширина то
        верни целиком
    конец
    пусть итог = ""
    для каждого слово из слова_текста
        пусть кандидат = если итог == "" то слово иначе итог + " " + слово
        если длина(кандидат) + длина(заполнитель) > ширина то
            стоп
        конец
        итог = кандидат
    конец
    верни (итог + заполнитель).обрезать_слева()
конец

функция убери_отступ(текст)
    # dedent: убирает общий отступ всех непустых строк
    пусть строки_текста = строка(текст).разделить("\n")
    пусть общий = -1
    для каждого стр из строки_текста
        если стр.обрезать() != "" то
            пусть отступ = длина(стр) - длина(стр.обрезать_слева())
            если общий < 0 или отступ < общий то
                общий = отступ
            конец
        конец
    конец
    если общий <= 0 то
        верни текст
    конец
    верни соедини(строки_текста.преобразуй(стр => если стр.обрезать() == "" то "" иначе стр.срез(общий)), "\n")
конец

функция добавь_отступ(текст, отступ)
    # indent: добавляет «отступ» в начало каждой непустой строки
    верни соедини(строка(текст).разделить("\n").преобразуй(стр => если стр.обрезать() == "" то стр иначе отступ + стр), "\n")
конец

функция по_центру(текст, ширина, заполнитель = " ")
    пусть т = строка(текст)
    если длина(т) >= ширина то
        верни т
    конец
    пусть слева = нацело(ширина - длина(т), 2)
    верни заполнитель * слева + т + заполнитель * (ширина - длина(т) - слева)
конец
