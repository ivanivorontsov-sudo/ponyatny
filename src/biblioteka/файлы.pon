# стд/файлы — сохранение данных между запусками
функция прочитай_строки(путь)
    если не файл_есть(путь) то
        верни []
    конец
    пусть итог = []
    для каждого с из прочитай_файл(путь).заменить("\r", "").разделить("\n")
        если с != "" то
            итог.добавь(с)
        конец
    конец
    верни итог
конец

функция запиши_строки(путь, строки_файла)
    пусть части = []
    для каждого с из строки_файла
        части.добавь(строка(с).заменить("\n", " "))
    конец
    запиши_файл(путь, части.соедини("\n") + "\n")
конец

функция допиши_строку(путь, текст)
    допиши_файл(путь, строка(текст).заменить("\n", " ") + "\n")
конец

функция сохрани_словарь(путь, словарь_данных)
    # формат «ключ=значение» по строке; значения — строки
    пусть строки_файла = []
    для каждого к, з из словарь_данных
        строки_файла.добавь(строка(к).заменить("=", "_") + "=" + строка(з).заменить("\n", " "))
    конец
    запиши_строки(путь, строки_файла)
конец

функция загрузи_словарь(путь)
    пусть итог = {}
    для каждого с из прочитай_строки(путь)
        пусть н = с.найди("=")
        если н > 0 то
            итог[с.срез(0, н)] = с.срез(н + 1, длина(с))
        конец
    конец
    верни итог
конец
