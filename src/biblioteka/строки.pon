# стд/строки — работа с текстом
функция дополни_слева(текст, ширина, знак = " ")
    пусть т = строка(текст)
    пока длина(т) < ширина
        т = знак + т
    конец
    верни т
конец

функция дополни_справа(текст, ширина, знак = " ")
    пусть т = строка(текст)
    пока длина(т) < ширина
        т = т + знак
    конец
    верни т
конец

функция по_центру(текст, ширина, знак = " ")
    пусть т = строка(текст)
    пусть слева = истина
    пока длина(т) < ширина
        если слева то
            т = т + знак
        иначе
            т = знак + т
        конец
        слева = не слева
    конец
    верни т
конец

функция слова(текст)
    пусть итог = []
    для каждого с из строка(текст).разделить(" ")
        если с.обрезать() != "" то
            итог.добавь(с.обрезать())
        конец
    конец
    верни итог
конец

функция сколько_раз(текст, кусок)
    если кусок == "" то
        верни 0
    конец
    верни длина(строка(текст).разделить(кусок)) - 1
конец

функция это_число(текст)
    попробуй
        число(текст)
        верни истина
    если ошибка как е
        верни ложь
    конец
конец

функция палиндром(текст)
    пусть т = маленькими(строка(текст)).заменить(" ", "")
    верни т == т.перевёрнуто()
конец

функция с_большой(текст)
    верни строка(текст).с_заглавной()
конец
