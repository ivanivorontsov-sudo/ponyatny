# стд/квант — симулятор квантового компьютера (вектор состояния, до 16 кубитов)
# Кубит 0 — младший разряд: состояние пишется как |q(n-1) … q1 q0⟩, так же, как в Qiskit.
# Вентили и формулы — стандартные (Nielsen, Chuang «Quantum Computation and Quantum Information»).
# Измерение использует свой генератор случайных чисел с зерном, поэтому каждый запуск
# с одним и тем же зерном даёт одни и те же результаты.

пусть навсегда КОРЕНЬ_ПОЛОВИНЫ = корень(0.5)

класс КвантовыйРегистр
    пусть число_кубитов = 1
    пусть ре = [1, 0]
    пусть им = [0, 0]
    пусть зерно = 2026

    функция создать(н, зерно = 2026)
        если н < 1 или н > 16 или н != вниз(н) то
            брось "В регистре может быть от 1 до 16 кубитов"
        конец
        это.число_кубитов = н
        пусть р = целое(степень(2, н))
        это.ре = [0] * р
        это.им = [0] * р
        это.ре[0] = 1
        это.зерно = зерно
    конец

    функция размерность()
        верни длина(это.ре)
    конец

    функция проверь_номер(к)
        если к < 0 или к >= это.число_кубитов или к != вниз(к) то
            брось "Нет кубита с номером {к}: в регистре кубиты от 0 до {это.число_кубитов - 1}"
        конец
    конец

    функция управляющие_включены(номер, контроли)
        для каждого к из контроли
            если бит_и(номер, сдвиг_влево(1, к)) == 0 то
                верни ложь
            конец
        конец
        верни истина
    конец

    # Матрица вентиля [[a, b], [c, d]], каждое число комплексное: (re, im)
    функция вентиль(к, ар, аи, бр, би, вр, ви, гр, ги, контроли = [])
        это.проверь_номер(к)
        для каждого у из контроли
            это.проверь_номер(у)
            если у == к то
                брось "Управляющий кубит не может совпадать с целевым"
            конец
        конец
        пусть маска = сдвиг_влево(1, к)
        пусть п = 0
        пусть всего = длина(это.ре)
        пока п < всего
            если бит_и(п, маска) == 0 и это.управляющие_включены(п, контроли) то
                пусть ж = бит_или(п, маска)
                пусть а0р = это.ре[п]
                пусть а0и = это.им[п]
                пусть а1р = это.ре[ж]
                пусть а1и = это.им[ж]
                это.ре[п] = ар * а0р - аи * а0и + бр * а1р - би * а1и
                это.им[п] = ар * а0и + аи * а0р + бр * а1и + би * а1р
                это.ре[ж] = вр * а0р - ви * а0и + гр * а1р - ги * а1и
                это.им[ж] = вр * а0и + ви * а0р + гр * а1и + ги * а1р
            конец
            п += 1
        конец
        верни это
    конец

    функция адамар(к)
        верни это.вентиль(к, КОРЕНЬ_ПОЛОВИНЫ, 0, КОРЕНЬ_ПОЛОВИНЫ, 0, КОРЕНЬ_ПОЛОВИНЫ, 0, -КОРЕНЬ_ПОЛОВИНЫ, 0)
    конец

    функция паули_x(к)
        верни это.вентиль(к, 0, 0, 1, 0, 1, 0, 0, 0)
    конец

    функция паули_y(к)
        верни это.вентиль(к, 0, 0, 0, -1, 0, 1, 0, 0)
    конец

    функция паули_z(к)
        верни это.вентиль(к, 1, 0, 0, 0, 0, 0, -1, 0)
    конец

    функция фаза(к, угол)
        верни это.вентиль(к, 1, 0, 0, 0, 0, 0, косинус(угол), синус(угол))
    конец

    функция фаза_s(к)
        верни это.фаза(к, ПИ / 2)
    конец

    функция фаза_t(к)
        верни это.фаза(к, ПИ / 4)
    конец

    функция поворот_x(к, угол)
        пусть к1 = косинус(угол / 2)
        пусть с1 = синус(угол / 2)
        верни это.вентиль(к, к1, 0, 0, -с1, 0, -с1, к1, 0)
    конец

    функция поворот_y(к, угол)
        пусть к1 = косинус(угол / 2)
        пусть с1 = синус(угол / 2)
        верни это.вентиль(к, к1, 0, -с1, 0, с1, 0, к1, 0)
    конец

    функция поворот_z(к, угол)
        пусть к1 = косинус(угол / 2)
        пусть с1 = синус(угол / 2)
        верни это.вентиль(к, к1, -с1, 0, 0, 0, 0, к1, с1)
    конец

    функция cnot(управляющий, целевой)
        верни это.вентиль(целевой, 0, 0, 1, 0, 1, 0, 0, 0, [управляющий])
    конец

    функция управляемое_не(управляющий, целевой)
        верни это.cnot(управляющий, целевой)
    конец

    функция cz(управляющий, целевой)
        верни это.вентиль(целевой, 1, 0, 0, 0, 0, 0, -1, 0, [управляющий])
    конец

    функция управляемая_фаза(управляющий, целевой, угол)
        верни это.вентиль(целевой, 1, 0, 0, 0, 0, 0, косинус(угол), синус(угол), [управляющий])
    конец

    функция тоффоли(первый, второй, целевой)
        верни это.вентиль(целевой, 0, 0, 1, 0, 1, 0, 0, 0, [первый, второй])
    конец

    функция обмен(а, б)
        это.cnot(а, б)
        это.cnot(б, а)
        это.cnot(а, б)
        верни это
    конец

    функция кет(номер)
        пусть т = ""
        пусть к = это.число_кубитов - 1
        пока к >= 0
            т += если бит_и(номер, сдвиг_влево(1, к)) != 0 то "1" иначе "0"
            к -= 1
        конец
        верни "|" + т + "⟩"
    конец

    функция вероятности()
        # словарь: базисное состояние → вероятность (только ненулевые)
        пусть итог = {}
        пусть п = 0
        пока п < длина(это.ре)
            пусть вер1 = это.ре[п] * это.ре[п] + это.им[п] * это.им[п]
            если вер1 > 0.0000000001 то
                итог[это.кет(п)] = округли(вер1, 10)
            конец
            п += 1
        конец
        верни итог
    конец

    функция вероятность_единицы(к)
        это.проверь_номер(к)
        пусть маска = сдвиг_влево(1, к)
        пусть вер1 = 0
        пусть п = 0
        пока п < длина(это.ре)
            если бит_и(п, маска) != 0 то
                вер1 += это.ре[п] * это.ре[п] + это.им[п] * это.им[п]
            конец
            п += 1
        конец
        верни округли(вер1, 10)
    конец

    функция случайное_число()
        # генератор Парка — Миллера: одно и то же зерно даёт одну и ту же последовательность
        это.зерно = (это.зерно * 48271) % 2147483647
        если это.зерно <= 0 то
            это.зерно += 2147483646
        конец
        верни это.зерно / 2147483647
    конец

    функция измерь(к)
        пусть р1 = это.вероятность_единицы(к)
        пусть итог = если это.случайное_число() < р1 то 1 иначе 0
        пусть маска = сдвиг_влево(1, к)
        пусть норма = корень(если итог == 1 то р1 иначе 1 - р1)
        пусть п = 0
        пока п < длина(это.ре)
            пусть бит = если бит_и(п, маска) != 0 то 1 иначе 0
            если бит == итог то
                это.ре[п] = это.ре[п] / норма
                это.им[п] = это.им[п] / норма
            иначе
                это.ре[п] = 0
                это.им[п] = 0
            конец
            п += 1
        конец
        верни итог
    конец

    функция измерь_все()
        пусть т = ""
        пусть к = это.число_кубитов - 1
        пусть биты = []
        для к2 от 0 до это.число_кубитов - 1
            биты.добавь(это.измерь(к2))
        конец
        пока к >= 0
            т += строка(биты[к])
            к -= 1
        конец
        верни т
    конец

    функция замеры(раз = 1000)
        # сколько раз выпало каждое состояние при многократном запуске (состояние не разрушается)
        пусть вер = это.вероятности()
        пусть ключи = вер.ключи()
        пусть итог = {}
        для каждого к из ключи
            итог[к] = 0
        конец
        повтори раз раз
            пусть х = это.случайное_число()
            пусть накоплено = 0
            пусть выбрано = ключи[длина(ключи) - 1]
            для каждого к из ключи
                накоплено += вер[к]
                если х < накоплено то
                    выбрано = к
                    стоп
                конец
            конец
            итог[выбрано] = итог[выбрано] + 1
        конец
        верни итог
    конец

    функция амплитуда(номер)
        верни [округли(это.ре[номер], 10), округли(это.им[номер], 10)]
    конец

    функция состояние()
        пусть части = []
        пусть п = 0
        пока п < длина(это.ре)
            пусть р = округли(это.ре[п], 4)
            пусть м = округли(это.им[п], 4)
            если р != 0 или м != 0 то
                пусть ч = ""
                если м == 0 то
                    ч = строка(р)
                иначе если р == 0 то
                    ч = строка(м) + "i"
                иначе
                    ч = "(" + строка(р) + (если м < 0 то " - " иначе " + ") + строка(модуль(м)) + "i)"
                конец
                части.добавь(ч + это.кет(п))
            конец
            п += 1
        конец
        если длина(части) == 0 то
            верни "0"
        конец
        пусть т = части[0]
        пусть п2 = 1
        пока п2 < длина(части)
            пусть ч2 = части[п2]
            если ч2.начинается("-") то
                т += " - " + ч2.срез(1)
            иначе
                т += " + " + ч2
            конец
            п2 += 1
        конец
        верни т
    конец

    функция строкой()
        верни "КвантовыйРегистр(" + строка(это.число_кубитов) + "): " + это.состояние()
    конец
конец

функция состояние_белла()
    # (|00⟩ + |11⟩) / √2 — запутанная пара
    пусть р = КвантовыйРегистр(2)
    р.адамар(0)
    р.cnot(0, 1)
    верни р
конец

функция состояние_ггц(н)
    # (|00…0⟩ + |11…1⟩) / √2
    пусть р = КвантовыйРегистр(н)
    р.адамар(0)
    для к от 1 до н - 1 шаг 1
        р.cnot(0, к)
    конец
    верни р
конец

функция квантовое_фурье(р)
    # квантовое преобразование Фурье над всеми кубитами регистра
    пусть н = р.число_кубитов
    пусть к = н - 1
    пока к >= 0
        р.адамар(к)
        пусть у = к - 1
        пока у >= 0
            р.управляемая_фаза(у, к, ПИ / степень(2, к - у))
            у -= 1
        конец
        к -= 1
    конец
    для п от 0 до вниз(н / 2) - 1 шаг 1
        р.обмен(п, н - 1 - п)
    конец
    верни р
конец

функция гровер(н, искомое, повторов = -1)
    # алгоритм Гровера: находит число «искомое» среди 2^н вариантов примерно за √(2^н) шагов
    пусть р = КвантовыйРегистр(н)
    пусть всего = целое(степень(2, н))
    если искомое < 0 или искомое >= всего то
        брось "Искомое число должно быть от 0 до {всего - 1}"
    конец
    если повторов < 0 то
        повторов = вниз(ПИ / 4 * корень(всего))
    конец
    для к от 0 до н - 1
        р.адамар(к)
    конец
    повтори повторов раз
        # оракул: меняет знак у искомого состояния
        р.ре[искомое] = -р.ре[искомое]
        р.им[искомое] = -р.им[искомое]
        # диффузия: отражение относительно среднего
        пусть ср = 0
        пусть ср_и = 0
        для п от 0 до всего - 1
            ср += р.ре[п]
            ср_и += р.им[п]
        конец
        ср = ср / всего
        ср_и = ср_и / всего
        для п от 0 до всего - 1
            р.ре[п] = 2 * ср - р.ре[п]
            р.им[п] = 2 * ср_и - р.им[п]
        конец
    конец
    верни р
конец

функция дойч_йожа(н, оракул)
    # «постоянная» или «сбалансированная» функция f: {0..2^н-1} → {0, 1} за один запрос
    пусть р = КвантовыйРегистр(н)
    пусть всего = целое(степень(2, н))
    для к от 0 до н - 1
        р.адамар(к)
    конец
    для п от 0 до всего - 1
        если оракул(п) == 1 то
            р.ре[п] = -р.ре[п]
            р.им[п] = -р.им[п]
        конец
    конец
    для к от 0 до н - 1
        р.адамар(к)
    конец
    пусть в0 = р.ре[0] * р.ре[0] + р.им[0] * р.им[0]
    верни если в0 > 0.5 то "постоянная" иначе "сбалансированная"
конец
