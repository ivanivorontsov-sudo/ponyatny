# стд/статистика — описательная статистика
# Перевод части модуля statistics из стандартной библиотеки Python 3.12 (© Python Software Foundation, лицензия PSF-2.0):
# mean, fmean, geometric_mean, harmonic_mean, median, median_low, median_high, mode, multimode,
# pvariance, variance, pstdev, stdev, quantiles, correlation, linear_regression.

функция проверь_данные(данные, минимум, имя_функции)
    если длина(данные) < минимум то
        брось "Для «{имя_функции}» нужно хотя бы {минимум} значений"
    конец
конец

функция среднее(данные)
    проверь_данные(данные, 1, "среднее")
    верни сумма(данные) / длина(данные)
конец

функция среднее_геометрическое(данные)
    проверь_данные(данные, 1, "среднее_геометрическое")
    пусть итог = 0
    для каждого х из данные
        если х <= 0 то
            брось "Среднее геометрическое считается только для положительных чисел"
        конец
        итог += логарифм(х)
    конец
    верни экспонента(итог / длина(данные))
конец

функция среднее_гармоническое(данные)
    проверь_данные(данные, 1, "среднее_гармоническое")
    пусть итог = 0
    для каждого х из данные
        если х < 0 то
            брось "Среднее гармоническое не считается для отрицательных чисел"
        конец
        если х == 0 то
            верни 0
        конец
        итог += 1 / х
    конец
    верни длина(данные) / итог
конец

функция медиана(данные)
    проверь_данные(данные, 1, "медиана")
    пусть д = данные.отсортировано()
    пусть н = длина(д)
    если н % 2 == 1 то
        верни д[нацело(н, 2)]
    конец
    верни (д[н / 2 - 1] + д[н / 2]) / 2
конец

функция медиана_нижняя(данные)
    проверь_данные(данные, 1, "медиана_нижняя")
    пусть д = данные.отсортировано()
    пусть н = длина(д)
    верни если н % 2 == 1 то д[нацело(н, 2)] иначе д[н / 2 - 1]
конец

функция медиана_верхняя(данные)
    проверь_данные(данные, 1, "медиана_верхняя")
    пусть д = данные.отсортировано()
    верни д[нацело(длина(д), 2)]
конец

функция все_моды(данные)
    # multimode: все самые частые значения в порядке первого появления
    пусть счёт = {}
    пусть порядок = []
    для каждого х из данные
        пусть ключ = строка(х)
        если не счёт.есть(ключ) то
            счёт[ключ] = 0
            порядок.добавь(х)
        конец
        счёт[ключ] = счёт[ключ] + 1
    конец
    пусть лучшее = 0
    для каждого х из порядок
        лучшее = макс(лучшее, счёт[строка(х)])
    конец
    верни порядок.отфильтруй(х => счёт[строка(х)] == лучшее)
конец

функция мода(данные)
    проверь_данные(данные, 1, "мода")
    верни все_моды(данные)[0]
конец

функция сумма_квадратов_отклонений(данные)
    пусть ср = среднее(данные)
    пусть итог = 0
    для каждого х из данные
        итог += (х - ср) * (х - ср)
    конец
    верни итог
конец

функция дисперсия_генеральная(данные)
    # pvariance
    проверь_данные(данные, 1, "дисперсия_генеральная")
    верни сумма_квадратов_отклонений(данные) / длина(данные)
конец

функция дисперсия(данные)
    # variance (выборочная, делится на n − 1)
    проверь_данные(данные, 2, "дисперсия")
    верни сумма_квадратов_отклонений(данные) / (длина(данные) - 1)
конец

функция отклонение_генеральное(данные)
    верни корень(дисперсия_генеральная(данные))
конец

функция стандартное_отклонение(данные)
    верни корень(дисперсия(данные))
конец

функция квантили(данные, частей = 4)
    # quantiles, метод «exclusive», как по умолчанию в Python
    если частей < 1 то
        брось "Число частей должно быть не меньше 1"
    конец
    проверь_данные(данные, 2, "квантили")
    пусть д = данные.отсортировано()
    пусть н = длина(д)
    пусть итог = []
    для номер от 1 до частей - 1 шаг 1
        пусть j = нацело(номер * (н + 1), частей)
        пусть дельта = номер * (н + 1) - j * частей
        если j < 1 то
            j = 1
            дельта = 0
        конец
        если j > н - 1 то
            j = н - 1
            дельта = частей
        конец
        итог.добавь((д[j - 1] * (частей - дельта) + д[j] * дельта) / частей)
    конец
    верни итог
конец

функция корреляция(хи, игреки)
    # коэффициент корреляции Пирсона
    если длина(хи) != длина(игреки) то
        брось "У списков для корреляции должна быть одинаковая длина"
    конец
    проверь_данные(хи, 2, "корреляция")
    пусть сх = среднее(хи)
    пусть су = среднее(игреки)
    пусть сху = 0
    пусть схх = 0
    пусть суу = 0
    для п от 0 до длина(хи) - 1
        пусть дх = хи[п] - сх
        пусть ду = игреки[п] - су
        сху += дх * ду
        схх += дх * дх
        суу += ду * ду
    конец
    если схх == 0 или суу == 0 то
        брось "Корреляция не определена: одно из значений постоянно"
    конец
    верни сху / корень(схх * суу)
конец

функция линейная_регрессия(хи, игреки)
    # возвращает словарь {"наклон", "сдвиг"}: у ≈ наклон * х + сдвиг
    если длина(хи) != длина(игреки) то
        брось "У списков для регрессии должна быть одинаковая длина"
    конец
    проверь_данные(хи, 2, "линейная_регрессия")
    пусть сх = среднее(хи)
    пусть су = среднее(игреки)
    пусть сху = 0
    пусть схх = 0
    для п от 0 до длина(хи) - 1
        сху += (хи[п] - сх) * (игреки[п] - су)
        схх += (хи[п] - сх) * (хи[п] - сх)
    конец
    если схх == 0 то
        брось "Регрессия не определена: все х одинаковые"
    конец
    пусть наклон = сху / схх
    верни {"наклон": наклон, "сдвиг": су - наклон * сх}
конец
