# стд/списки — работа со списками и словарями
функция уникальные(список_значений)
    пусть итог = []
    для каждого x из список_значений
        если не (x в итог) то
            итог.добавь(x)
        конец
    конец
    верни итог
конец

функция подсчитай(список_значений)
    # словарь: значение → сколько раз встретилось
    пусть итог = {}
    для каждого x из список_значений
        пусть ключ = строка(x)
        итог[ключ] = итог.получи(ключ, 0) + 1
    конец
    верни итог
конец

функция разбей(список_значений, размер)
    пусть итог = []
    пусть кусок = []
    для каждого x из список_значений
        кусок.добавь(x)
        если длина(кусок) == размер то
            итог.добавь(кусок)
            кусок = []
        конец
    конец
    если длина(кусок) > 0 то
        итог.добавь(кусок)
    конец
    верни итог
конец

функция соедини_пары(первый, второй)
    пусть итог = []
    пусть н = мин(длина(первый), длина(второй))
    для i от 0 до н - 1
        итог.добавь([первый[i], второй[i]])
    конец
    верни итог
конец

функция наибольший_по(список_значений, оценка)
    если длина(список_значений) == 0 то
        верни ничего
    конец
    пусть лучший = список_значений[0]
    для каждого x из список_значений
        если оценка(x) > оценка(лучший) то
            лучший = x
        конец
    конец
    верни лучший
конец

функция сгруппируй(список_значений, ключ_для)
    пусть итог = {}
    для каждого x из список_значений
        пусть к = строка(ключ_для(x))
        если не итог.есть(к) то
            итог[к] = []
        конец
        итог[к].добавь(x)
    конец
    верни итог
конец

функция диапазон(начало, конец_диапазона, шаг_диапазона = 1)
    верни от(начало, конец_диапазона, шаг_диапазона)
конец
