# стд/куча — очередь с приоритетом (двоичная куча)
# Перевод модуля heapq из стандартной библиотеки Python 3.12 (© Python Software Foundation, лицензия PSF-2.0).
# Как в Python: куча — обычный список, наименьший элемент всегда в куча[0].

функция просеять_вниз(куча, начало, позиция)
    # _siftdown из heapq.py
    пусть элемент_н = куча[позиция]
    пока позиция > начало
        пусть предок_н = нацело(позиция - 1, 2)
        пусть предок = куча[предок_н]
        если элемент_н < предок то
            куча[позиция] = предок
            позиция = предок_н
            дальше
        конец
        стоп
    конец
    куча[позиция] = элемент_н
конец

функция просеять_вверх(куча, позиция)
    # _siftup из heapq.py
    пусть конечная = длина(куча)
    пусть начальная = позиция
    пусть элемент_н = куча[позиция]
    пусть ребёнок = 2 * позиция + 1
    пока ребёнок < конечная
        пусть правый = ребёнок + 1
        если правый < конечная и не (куча[ребёнок] < куча[правый]) то
            ребёнок = правый
        конец
        куча[позиция] = куча[ребёнок]
        позиция = ребёнок
        ребёнок = 2 * позиция + 1
    конец
    куча[позиция] = элемент_н
    просеять_вниз(куча, начальная, позиция)
конец

функция положи_в_кучу(куча, элемент)
    # heappush
    куча.добавь(элемент)
    просеять_вниз(куча, 0, длина(куча) - 1)
конец

функция достань_из_кучи(куча)
    # heappop: убирает и возвращает наименьший элемент
    если длина(куча) == 0 то
        брось "Куча пуста"
    конец
    пусть последний = куча.убери()
    если длина(куча) > 0 то
        пусть наименьший = куча[0]
        куча[0] = последний
        просеять_вверх(куча, 0)
        верни наименьший
    конец
    верни последний
конец

функция замени_в_куче(куча, элемент)
    # heapreplace: достаёт наименьший и кладёт элемент_н за один шаг
    если длина(куча) == 0 то
        брось "Куча пуста"
    конец
    пусть наименьший = куча[0]
    куча[0] = элемент
    просеять_вверх(куча, 0)
    верни наименьший
конец

функция сделай_кучу(список_значений)
    # heapify: превращает список в кучу на месте за линейное время
    пусть н = длина(список_значений)
    пусть п = нацело(н, 2) - 1
    пока п >= 0
        просеять_вверх(список_значений, п)
        п -= 1
    конец
    верни список_значений
конец

функция наименьшие(сколько, список_значений)
    # nsmallest
    пусть куча = список_значений.копия()
    сделай_кучу(куча)
    пусть итог = []
    пока длина(итог) < сколько и длина(куча) > 0
        итог.добавь(достань_из_кучи(куча))
    конец
    верни итог
конец

функция наибольшие(сколько, список_значений)
    # nlargest
    верни список_значений.отсортировано().перевёрнуто().срез(0, сколько)
конец
