# стд/игра — заготовки для игр: спрайты, столкновения, счёт и таймеры
# Рисование и управление — встроенные команды «окно», «каждый_кадр», «клавиша», «прямоугольник», «круг» и др.
# Проверка столкновений прямоугольников (AABB) и окружностей — классические формулы игровой физики.

класс Спрайт
    пусть x = 0
    пусть y = 0
    пусть ширина = 32
    пусть высота = 32
    пусть скорость_x = 0
    пусть скорость_y = 0
    пусть цвет = "белый"
    пусть живой = истина

    функция создать(x = 0, y = 0, ширина = 32, высота = 32, цвет = "белый")
        это.x = x
        это.y = y
        это.ширина = ширина
        это.высота = высота
        это.цвет = цвет
    конец

    функция двигай(дт = 1)
        это.x += это.скорость_x * дт
        это.y += это.скорость_y * дт
    конец

    функция центр_x()
        верни это.x + это.ширина / 2
    конец

    функция центр_y()
        верни это.y + это.высота / 2
    конец

    функция касается(другой)
        верни пересекаются(это.x, это.y, это.ширина, это.высота, другой.x, другой.y, другой.ширина, другой.высота)
    конец

    функция держи_в_границах(ширина_поля, высота_поля)
        это.x = ограничь_значение(это.x, 0, ширина_поля - это.ширина)
        это.y = ограничь_значение(это.y, 0, высота_поля - это.высота)
    конец

    функция отскок_от_стен(ширина_поля, высота_поля)
        если это.x < 0 или это.x + это.ширина > ширина_поля то
            это.скорость_x = -это.скорость_x
            это.x = ограничь_значение(это.x, 0, ширина_поля - это.ширина)
        конец
        если это.y < 0 или это.y + это.высота > высота_поля то
            это.скорость_y = -это.скорость_y
            это.y = ограничь_значение(это.y, 0, высота_поля - это.высота)
        конец
    конец

    функция нарисуй()
        если это.живой то
            прямоугольник(это.x, это.y, это.ширина, это.высота, это.цвет)
        конец
    конец
конец

функция ограничь_значение(значение, наименьшее, наибольшее)
    верни макс(наименьшее, мин(наибольшее, значение))
конец

функция круги_касаются(x1, y1, р1, x2, y2, р2)
    пусть дх = x1 - x2
    пусть ду = y1 - y2
    верни дх * дх + ду * ду <= (р1 + р2) * (р1 + р2)
конец

функция точка_в_прямоугольнике(тх, ту, x, y, ширина, высота)
    верни тх >= x и тх <= x + ширина и ту >= y и ту <= y + высота
конец

класс Таймер
    пусть интервал = 1
    пусть накоплено = 0

    функция создать(интервал = 1)
        это.интервал = интервал
    конец

    функция тик(дт)
        # истина, когда прошёл очередной интервал (в секундах)
        это.накоплено += дт
        если это.накоплено >= это.интервал то
            это.накоплено -= это.интервал
            верни истина
        конец
        верни ложь
    конец
конец

класс Счёт
    пусть очки = 0
    пусть рекорд = 0
    пусть жизни = 3

    функция добавь_очки(сколько = 1)
        это.очки += сколько
        если это.очки > это.рекорд то
            это.рекорд = это.очки
        конец
    конец

    функция потеряй_жизнь()
        это.жизни -= 1
        верни это.жизни <= 0
    конец

    функция заново()
        это.очки = 0
        это.жизни = 3
    конец

    функция нарисуй(x = 10, y = 10, цвет = "белый")
        рисуй_текст(x, y, "Очки: {это.очки}   Рекорд: {это.рекорд}   Жизни: {это.жизни}", цвет, 18)
    конец
конец
