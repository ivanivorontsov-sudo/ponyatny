# стд/плавность — функции плавности для анимаций и игр
# Перевод «Easing Equations» Роберта Пеннера (© 2001 Robert Penner, лицензия BSD-3-Clause)
# в форме из easings.net: на вход доля времени т от 0 до 1, на выходе доля пути.

функция линейно(т)
    верни т
конец

функция плавно_вход_квадрат(т)
    верни т * т
конец

функция плавно_выход_квадрат(т)
    верни 1 - (1 - т) * (1 - т)
конец

функция плавно_квадрат(т)
    верни если т < 0.5 то 2 * т * т иначе 1 - степень(-2 * т + 2, 2) / 2
конец

функция плавно_вход_куб(т)
    верни т * т * т
конец

функция плавно_выход_куб(т)
    верни 1 - степень(1 - т, 3)
конец

функция плавно_куб(т)
    верни если т < 0.5 то 4 * т * т * т иначе 1 - степень(-2 * т + 2, 3) / 2
конец

функция плавно_синус(т)
    верни -(косинус(ПИ * т) - 1) / 2
конец

функция плавно_вход_синус(т)
    верни 1 - косинус((т * ПИ) / 2)
конец

функция плавно_выход_синус(т)
    верни синус((т * ПИ) / 2)
конец

функция плавно_вход_экспонента(т)
    верни если т == 0 то 0 иначе степень(2, 10 * т - 10)
конец

функция плавно_выход_экспонента(т)
    верни если т == 1 то 1 иначе 1 - степень(2, -10 * т)
конец

функция плавно_вход_круг(т)
    верни 1 - корень(1 - степень(т, 2))
конец

функция плавно_выход_круг(т)
    верни корень(1 - степень(т - 1, 2))
конец

функция плавно_вход_назад(т)
    пусть с1 = 1.70158
    пусть с3 = с1 + 1
    верни с3 * т * т * т - с1 * т * т
конец

функция плавно_выход_назад(т)
    пусть с1 = 1.70158
    пусть с3 = с1 + 1
    верни 1 + с3 * степень(т - 1, 3) + с1 * степень(т - 1, 2)
конец

функция плавно_выход_пружина(т)
    если т == 0 или т == 1 то
        верни т
    конец
    пусть с4 = (2 * ПИ) / 3
    верни степень(2, -10 * т) * синус((т * 10 - 0.75) * с4) + 1
конец

функция плавно_выход_отскок(т)
    пусть н1 = 7.5625
    пусть д1 = 2.75
    если т < 1 / д1 то
        верни н1 * т * т
    конец
    если т < 2 / д1 то
        т -= 1.5 / д1
        верни н1 * т * т + 0.75
    конец
    если т < 2.5 / д1 то
        т -= 2.25 / д1
        верни н1 * т * т + 0.9375
    конец
    т -= 2.625 / д1
    верни н1 * т * т + 0.984375
конец

функция плавно_вход_отскок(т)
    верни 1 - плавно_выход_отскок(1 - т)
конец

функция между(начало, конец_пути, т, плавность = линейно)
    # значение между «начало» и «конец_пути» для доли т с нужной плавностью
    пусть д = макс(0, мин(1, т))
    верни начало + (конец_пути - начало) * плавность(д)
конец
