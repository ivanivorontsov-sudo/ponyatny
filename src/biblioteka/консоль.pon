# стд/консоль — удобный ввод, меню и оформление вывода
функция спроси_число(вопрос, наименьшее = ничего, наибольшее = ничего)
    # спрашивает, пока не введут число (в границах); при конце ввода возвращает ничего
    пока истина
        пусть ответ = спроси(вопрос)
        если ответ == ничего или ответ == "" то
            верни ничего
        конец
        попробуй
            пусть н = число(ответ)
            если наименьшее != ничего и н < наименьшее то
                напиши "Нужно не меньше {наименьшее}"
            иначе если наибольшее != ничего и н > наибольшее то
                напиши "Нужно не больше {наибольшее}"
            иначе
                верни н
            конец
        если ошибка как е
            напиши "Это не число, попробуйте ещё раз"
        конец
    конец
конец

функция спроси_да_нет(вопрос)
    пусть ответ = маленькими(строка(спроси(вопрос + " (да/нет)"))).обрезать()
    верни ответ в ["да", "д", "yes", "y", "конечно", "ага"]
конец

функция меню(заголовок, пункты)
    # показывает пункты с номерами и возвращает номер выбранного (0 — выход)
    напиши ""
    напиши "== " + заголовок + " =="
    для каждого номер, пункт из пункты
        напиши "  {номер + 1} — {пункт}"
    конец
    напиши "  0 — выход"
    пусть выбор_номер = спроси_число("Ваш выбор:", 0, длина(пункты))
    верни если выбор_номер == ничего то 0 иначе целое(выбор_номер)
конец

функция рамка(текст)
    пусть строки_текста = строка(текст).разделить("\n")
    пусть ширина = 0
    для каждого с из строки_текста
        ширина = макс(ширина, длина(с))
    конец
    напиши "┌" + "─" * (ширина + 2) + "┐"
    для каждого с из строки_текста
        пусть т = с
        пока длина(т) < ширина
            т = т + " "
        конец
        напиши "│ " + т + " │"
    конец
    напиши "└" + "─" * (ширина + 2) + "┘"
конец

функция полоска(доля, ширина = 20)
    # полоска прогресса: доля от 0 до 1
    пусть д = доля
    если д < 0 то
        д = 0
    конец
    если д > 1 то
        д = 1
    конец
    пусть заполнено = округли(д * ширина)
    верни "[" + "█" * заполнено + "░" * (ширина - заполнено) + "] " + строка(округли(д * 100)) + "%"
конец

функция таблица(заголовки, строки_таблицы)
    # печатает таблицу; строки_таблицы — список списков
    пусть ширины = []
    для каждого з из заголовки
        ширины.добавь(длина(строка(з)))
    конец
    для каждого р из строки_таблицы
        для каждого i, ячейка из р
            если i < длина(ширины) то
                ширины[i] = макс(ширины[i], длина(строка(ячейка)))
            конец
        конец
    конец
    функция ряд(значения)
        пусть части = []
        для каждого i, ш из ширины
            пусть т = если i < длина(значения) то строка(значения[i]) иначе ""
            пока длина(т) < ш
                т = т + " "
            конец
            части.добавь(т)
        конец
        верни "| " + части.соедини(" | ") + " |"
    конец
    напиши ряд(заголовки)
    пусть черта = []
    для каждого ш из ширины
        черта.добавь("-" * ш)
    конец
    напиши "|-" + черта.соедини("-|-") + "-|"
    для каждого р из строки_таблицы
        напиши ряд(р)
    конец
конец

функция очисти_экран()
    напиши "\u{1B}[2J\u{1B}[H"
конец

функция деньги(сумма_денег)
    верни формат_числа(сумма_денег, 2) + " ₽"
конец
