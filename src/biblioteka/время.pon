# стд/время — дата, время и секундомер
пусть навсегда НАЗВАНИЯ_ДНЕЙ = ["понедельник", "вторник", "среда", "четверг", "пятница", "суббота", "воскресенье"]
пусть навсегда НАЗВАНИЯ_МЕСЯЦЕВ = ["января", "февраля", "марта", "апреля", "мая", "июня", "июля", "августа", "сентября", "октября", "ноября", "декабря"]

функция две_цифры(н)
    верни если н < 10 то "0" + строка(н) иначе строка(н)
конец

функция сегодня()
    пусть д = дата_сейчас()
    верни две_цифры(д["день"]) + "." + две_цифры(д["месяц"]) + "." + строка(д["год"])
конец

функция сейчас()
    пусть д = дата_сейчас()
    верни две_цифры(д["час"]) + ":" + две_цифры(д["минута"])
конец

функция день_недели()
    верни НАЗВАНИЯ_ДНЕЙ[дата_сейчас()["день_недели"] - 1]
конец

функция дата_словами()
    пусть д = дата_сейчас()
    верни строка(д["день"]) + " " + НАЗВАНИЯ_МЕСЯЦЕВ[д["месяц"] - 1] + " " + строка(д["год"]) + " года"
конец

функция високосный(год)
    верни (год % 4 == 0 и год % 100 != 0) или год % 400 == 0
конец

функция дней_в_месяце(месяц, год)
    если месяц == 2 то
        верни если високосный(год) то 29 иначе 28
    конец
    если месяц в [4, 6, 9, 11] то
        верни 30
    конец
    верни 31
конец

класс Секундомер
    пусть начало = 0
    функция создать()
        это.начало = время()
    конец
    функция прошло()
        верни время() - это.начало
    конец
    функция заново()
        это.начало = время()
    конец
конец

функция подожди(секунд)
    пауза(секунд * 1000)
конец
