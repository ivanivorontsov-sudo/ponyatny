# стд/цвет — цвета: RGB, HSV, HLS и запись «#rrggbb»
# Функции перевода между моделями — перевод модуля colorsys из стандартной библиотеки Python 3.12
# (© Python Software Foundation, лицензия PSF-2.0). Все составляющие — числа от 0 до 1.

функция rgb_в_hsv(к, з, с2)
    пусть наиб = макс(к, з, с2)
    пусть наим = мин(к, з, с2)
    пусть яркость = наиб
    если наим == наиб то
        верни [0, 0, яркость]
    конец
    пусть насыщенность = (наиб - наим) / наиб
    пусть кк = (наиб - к) / (наиб - наим)
    пусть зз = (наиб - з) / (наиб - наим)
    пусть сс = (наиб - с2) / (наиб - наим)
    пусть тон = 0
    если к == наиб то
        тон = сс - зз
    иначе если з == наиб то
        тон = 2 + кк - сс
    иначе
        тон = 4 + зз - кк
    конец
    тон = (тон / 6) % 1
    если тон < 0 то
        тон += 1
    конец
    верни [тон, насыщенность, яркость]
конец

функция hsv_в_rgb(тон, насыщенность, яркость)
    если насыщенность == 0 то
        верни [яркость, яркость, яркость]
    конец
    пусть сектор = целое(тон * 6)
    пусть доля = тон * 6 - сектор
    пусть п1 = яркость * (1 - насыщенность)
    пусть п2 = яркость * (1 - насыщенность * доля)
    пусть п3 = яркость * (1 - насыщенность * (1 - доля))
    сектор = сектор % 6
    выбор сектор
        вариант 0
            верни [яркость, п3, п1]
        вариант 1
            верни [п2, яркость, п1]
        вариант 2
            верни [п1, яркость, п3]
        вариант 3
            верни [п1, п2, яркость]
        вариант 4
            верни [п3, п1, яркость]
        иначе
            верни [яркость, п1, п2]
    конец
конец

функция _составляющая(м1, м2, тон)
    тон = тон % 1
    если тон < 0 то
        тон += 1
    конец
    если тон < 1 / 6 то
        верни м1 + (м2 - м1) * тон * 6
    конец
    если тон < 0.5 то
        верни м2
    конец
    если тон < 2 / 3 то
        верни м1 + (м2 - м1) * (2 / 3 - тон) * 6
    конец
    верни м1
конец

функция rgb_в_hls(к, з, с2)
    пусть наиб = макс(к, з, с2)
    пусть наим = мин(к, з, с2)
    пусть сумма_крайних = наиб + наим
    пусть размах = наиб - наим
    пусть светлота = сумма_крайних / 2
    если наим == наиб то
        верни [0, светлота, 0]
    конец
    пусть насыщенность = если светлота <= 0.5 то размах / сумма_крайних иначе размах / (2 - наиб - наим)
    пусть кк = (наиб - к) / размах
    пусть зз = (наиб - з) / размах
    пусть сс = (наиб - с2) / размах
    пусть тон = 0
    если к == наиб то
        тон = сс - зз
    иначе если з == наиб то
        тон = 2 + кк - сс
    иначе
        тон = 4 + зз - кк
    конец
    тон = (тон / 6) % 1
    если тон < 0 то
        тон += 1
    конец
    верни [тон, светлота, насыщенность]
конец

функция hls_в_rgb(тон, светлота, насыщенность)
    если насыщенность == 0 то
        верни [светлота, светлота, светлота]
    конец
    пусть м2 = если светлота <= 0.5 то светлота * (1 + насыщенность) иначе светлота + насыщенность - светлота * насыщенность
    пусть м1 = 2 * светлота - м2
    верни [_составляющая(м1, м2, тон + 1 / 3), _составляющая(м1, м2, тон), _составляющая(м1, м2, тон - 1 / 3)]
конец

функция _две_hex(х)
    пусть н = целое(округли(ограничь_цвет(х) * 255))
    пусть цифры = "0123456789abcdef"
    верни цифры[нацело(н, 16)] + цифры[н % 16]
конец

функция ограничь_цвет(х)
    верни макс(0, мин(1, х))
конец

функция в_hex(к, з, с2)
    # [0..1] → "#rrggbb"
    верни "#" + _две_hex(к) + _две_hex(з) + _две_hex(с2)
конец

функция из_hex(текст)
    # "#rrggbb" → [к, з, с] от 0 до 1
    пусть т = маленькими(текст).обрезать()
    если т.начинается("#") то
        т = т.срез(1)
    конец
    если длина(т) != 6 то
        брось "Цвет пишется как #rrggbb, а получено «{текст}»"
    конец
    пусть цифры = "0123456789abcdef"
    пусть итог = []
    для п от 0 до 2
        пусть ст = цифры.найди(т[2 * п])
        пусть мл = цифры.найди(т[2 * п + 1])
        если ст < 0 или мл < 0 то
            брось "В записи цвета «{текст}» есть не шестнадцатеричные цифры"
        конец
        итог.добавь((ст * 16 + мл) / 255)
    конец
    верни итог
конец

функция смешай(первый, второй, доля = 0.5)
    # смешивает два цвета «#rrggbb»
    пусть а = из_hex(первый)
    пусть б = из_hex(второй)
    верни в_hex(а[0] + (б[0] - а[0]) * доля, а[1] + (б[1] - а[1]) * доля, а[2] + (б[2] - а[2]) * доля)
конец

функция радуга(доля)
    # цвет радуги для доли от 0 до 1
    пусть р = hsv_в_rgb(доля % 1, 1, 1)
    верни в_hex(р[0], р[1], р[2])
конец
