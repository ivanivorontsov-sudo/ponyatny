// Классы, объекты, поля, вызовы, перебор.
// ---------- подсказки ----------
fn lev_cp(a, b) {
  var A[64]; var B[64]; var d[4300];
  var tmp[1]; var na = 0; var nb = 0; var la = strlen(a); var lb = strlen(b); var i = 0; var j = 0;
  while (i < la && na < 64) { i += utf8_dec(a, la, i, tmp); A[na] = tmp[0]; na += 1; }
  i = 0; while (i < lb && nb < 64) { i += utf8_dec(b, lb, i, tmp); B[nb] = tmp[0]; nb += 1; }
  var w = nb + 1;
  i = 0; while (i <= na) { d[i * w] = i; i += 1; }
  j = 0; while (j <= nb) { d[j] = j; j += 1; }
  i = 1;
  while (i <= na) {
    j = 1;
    while (j <= nb) {
      var x = d[(i - 1) * w + j] + 1; var y = d[i * w + j - 1] + 1; var z = d[(i - 1) * w + j - 1];
      if (A[i - 1] != B[j - 1]) { z += 1; }
      if (y < x) { x = y; } if (z < x) { x = z; }
      d[i * w + j] = x; j += 1;
    }
    i += 1;
  }
  return d[na * w + nb];
}
global hint_buf[40];
// names — список строк «Понятного»
fn hint_names(w, names) {
  var best = 0; var bd = 3; var i = 0;
  while (i < LEN(names)) { var nm = ITEMS(names)[i]; var dd = lev_cp(w, S(nm)); if (dd < bd) { bd = dd; best = nm; } i += 1; }
  if (best == 0) { st8(hint_buf, 0); return hint_buf; }
  snprintf(hint_buf, 300, " Возможно, вы имели в виду «%s»?", S(best));
  return hint_buf;
}
fn keys_into(l, d) { var i = 0; var n = dict_n(d); while (i < n) { var k = dict_k(d, i); if (is_t(k, T_STR)) { list_push(l, k); } i += 1; } return l; }

// ---------- классы ----------
fn cls_table(c, t) { var p = c & LOW48; if (t == 0) { return p->methods; } if (t == 1) { return p->getters; } if (t == 2) { return p->setters; } return p->statics; }
fn cls_lookup(c, t, k) {
  while (is_t(c, T_CLASS)) { var v = dict_get(cls_table(c, t), k); if (v != UNDEF) { return v; } c = (c & LOW48)->parent; }
  return UNDEF;
}
fn cls_has_any(c, k) { return cls_lookup(c, 0, k) != UNDEF || cls_lookup(c, 1, k) != UNDEF || cls_lookup(c, 2, k) != UNDEF; }
fn cls_name(c) { return S((c & LOW48)->cname); }
fn obj_hint(o, k) {
  var l = list_new(8); rt_tmp[4] = l;
  keys_into(l, (o & LOW48)->fields);
  var c = (o & LOW48)->ocls;
  while (is_t(c, T_CLASS)) { keys_into(l, (c & LOW48)->methods); keys_into(l, (c & LOW48)->getters); keys_into(l, (c & LOW48)->setters); c = (c & LOW48)->parent; }
  var h = hint_names(k, l); rt_tmp[4] = UNDEF; return h;
}
fn statics_hint(c, k) { var l = list_new(8); rt_tmp[4] = l; keys_into(l, (c & LOW48)->statics); var h = hint_names(k, l); rt_tmp[4] = UNDEF; return h; }
fn rt_class_new(name, parent) {
  if (!ISNIL(parent) && !is_t(parent, T_CLASS)) { rt_failf("наследовать можно только от класса, а не от «%s»", type_name(parent), 0, 0); }
  var p = gc_alloc(T_CLASS); var cv = HV(p);
  rt_tmp[1] = cv;
  p->cname = name; p->parent = NUL; if (!ISNIL(parent)) { p->parent = parent; }
  p->cinit = NUL; p->ctors = NUL; p->cifaces = NUL; p->cnative = NUL;
  p->methods = NUL; p->getters = NUL; p->setters = NUL; p->statics = NUL;
  p->methods = dict_new(0); p->getters = dict_new(0); p->setters = dict_new(0); p->statics = dict_new(0);
  rt_tmp[1] = UNDEF;
  return cv;
}
// kind: 0 функция, 1 свойство (чтение), 2 запись, 3 общая
fn rt_class_add(c, kind, k, f) { dict_set(cls_table(c, kind), k, f); return 0; }
fn rt_class_init(c, f) { (c & LOW48)->cinit = f; return 0; }
fn rt_class_struct(c, f) { (c & LOW48)->cinit = f; st8((c & LOW48) + 3, 1); return 0; }
fn rt_class_ctor(c, f) { var p = c & LOW48; if (!is_t(p->ctors, T_LIST)) { p->ctors = list_new(4); } list_push(p->ctors, f); return 0; }
fn bind_fn(f, self) {
  var o = f & LOW48;
  var r = rt_fn(o->code, o->nenv, o->fname, o->arity & 0xFFFF, o->arity >> 16);
  var n = r & LOW48; var i = 0;
  while (i < o->nenv) { n->env[i] = o->env[i]; i += 1; }
  n->cptr = o->cptr; n->fself = self;
  return r;
}
fn rt_callf(f, self, argc, argv) {
  if (is_t(f, T_FN)) { var p = f & LOW48; if (p->fself != UNDEF) { self = p->fself; } return callptr(p->code, f, self, argc, argv); }
  if (is_t(f, T_CLASS)) { return rt_new(f, argc, argv); }
  rt_failf("«значение» — это не функция, а %s", type_name(f), 0, 0); return 0;
}
fn rt_callv(f, argc, argv) { return rt_callf(f, UNDEF, argc, argv); }
fn rt_apply(f, name, argc, argv) {
  if (!is_t(f, T_FN) && !is_t(f, T_CLASS)) { rt_failf("«%s» — это не функция, а %s", name, type_name(f), 0); }
  return rt_callf(f, UNDEF, argc, argv);
}
fn rt_sapply(f, argc, argv) { if (ISNIL(f)) { return NUL; } return rt_apply(f, "значение", argc, argv); }
fn rt_obj_new(c) { var o = gc_alloc(T_OBJ); o->ocls = c; o->fields = NUL; var ov = HV(o); rt_tmp[2] = ov; o->fields = dict_new(0); rt_tmp[2] = UNDEF; return ov; }
fn run_init(c, o) {
  var p = c & LOW48;
  if (is_t(p->parent, T_CLASS)) { run_init(p->parent, o); }
  if (is_t(p->cinit, T_FN)) { rt_callf(p->cinit, o, 0, 0); }
  return 0;
}
fn pick_ctor(ctors, n) {
  var i = 0; var loose = -1;
  while (i < LEN(ctors)) {
    var f = ITEMS(ctors)[i] & LOW48; var mn = f->arity & 0xFFFF; var mx = f->arity >> 16;
    if (n >= mn && n <= mx) { if (n == mx) { return ITEMS(ctors)[i]; } if (loose < 0) { loose = i; } }
    i += 1;
  }
  if (loose >= 0) { return ITEMS(ctors)[loose]; }
  rt_failf("нет функции «создать» для %d значений", n, 0, 0); return 0;
}
fn rt_new(c, argc, argv) {
  if (!is_t(c, T_CLASS)) { rt_failf("«%s» — не класс", type_name(c), 0, 0); }
  var p = c & LOW48;
  if (is_t(p->cnative, T_FN)) { return rt_callf(p->cnative, c, argc, argv); }
  var o = rt_obj_new(c);
  if (ld8(p + 3) & 1) { rt_callf(p->cinit, o, argc, argv); return o; }
  run_init(c, o);
  var cc = c;
  while (is_t(cc, T_CLASS)) { if (is_t((cc & LOW48)->ctors, T_LIST) && LEN((cc & LOW48)->ctors) > 1) { rt_callf(pick_ctor((cc & LOW48)->ctors, argc), o, argc, argv); return o; } cc = (cc & LOW48)->parent; }
  var m = cls_lookup(c, 0, rt_K[1]);
  if (m != UNDEF) { rt_callf(m, o, argc, argv); }
  else if (argc) { rt_failf("у класса «%s» нет функции «создать», поэтому ему нельзя передавать значения", cls_name(c), 0, 0); }
  return o;
}
fn rt_super_call(c, self, k, argc, argv) {
  var par = (c & LOW48)->parent; var m = UNDEF;
  if (is_t(par, T_CLASS)) {
    m = cls_lookup(par, 0, k);
    if (m == UNDEF && str_eqc(k, "создать") && is_t((par & LOW48)->ctors, T_LIST) && LEN((par & LOW48)->ctors) > 1) { m = pick_ctor((par & LOW48)->ctors, argc); }
    if (m == UNDEF) { m = cls_lookup(par, 3, k); }
  }
  if (m != UNDEF) { return rt_callf(m, self, argc, argv); }
  if (str_eqc(k, "создать")) { return NUL; }
  rt_failf("у родителя нет функции «%s»", S(k), 0, 0); return 0;
}
fn instance_of(v, c) {
  if (!is_t(v, T_OBJ)) { return 0; }
  var x = (v & LOW48)->ocls;
  while (is_t(x, T_CLASS)) { if (x == c) { return 1; } x = (x & LOW48)->parent; }
  return 0;
}
fn iface_ok(v, i) {
  if (!is_t(v, T_OBJ)) { return 0; }
  var l = (i & LOW48)->imethods; var j = 0;
  while (j < LEN(l)) {
    var k = ITEMS(l)[j]; var f = dict_get((v & LOW48)->fields, k);
    if (f != UNDEF) { if (!is_t(f, T_FN)) { return 0; } } else if (cls_lookup((v & LOW48)->ocls, 0, k) == UNDEF) { return 0; }
    j += 1;
  }
  return 1;
}
fn rt_iface(name, n, methods) { var f = gc_alloc(T_IFACE); f->iname = name; f->imethods = NUL; var r = HV(f); rt_tmp[3] = r; f->imethods = rt_list(n, methods); rt_tmp[3] = UNDEF; return r; }
fn rt_implements(c, n, ifs) {
  var k = 0;
  while (k < n) {
    var i = ifs[k];
    if (is_t(i, T_IFACE)) {
      var l = (i & LOW48)->imethods; var j = 0;
      while (j < LEN(l)) { if (cls_lookup(c, 0, ITEMS(l)[j]) == UNDEF) { rt_failf("класс «%s» обещал «реализует %s», но в нём нет функции «%s»", cls_name(c), S((i & LOW48)->iname), S(ITEMS(l)[j])); } j += 1; }
    }
    k += 1;
  }
  return 0;
}
fn rt_isa(v, t, c) {
  if (strcmp(t, "любое") == 0) { return 1; }
  if (is_t(c, T_CLASS) && (ld8((c & LOW48) + 3) & 2)) { return 1; }
  if (is_t(c, T_CLASS)) { return instance_of(v, c); }
  if (is_t(c, T_IFACE)) { return iface_ok(v, c); }
  if (strcmp(t, "целое") == 0) { return isnum(v) && feq(ffloor(v), v) && fne(v, 1e400) && fne(v, -1e400); }
  return strcmp(type_name(v), t) == 0;
}
fn rt_tp(v, t, name, c) {
  if (strcmp(t, "любое") == 0) { return v; }
  var ok = 0;
  if (strcmp(t, "Ошибка") == 0) { ok = instance_of(v, c); } else { ok = rt_isa(v, t, c); }
  if (!ok) { rt_failf("«%s» должно быть типа «%s», а получено: %s", name, t, type_name(v)); }
  return v;
}

// ---------- значения по ключу ----------
fn mutate(o) { if (isheap(o) && ld8((o & LOW48) + 2)) { rt_fail("это значение объявлено «навсегда», его нельзя менять"); } return 0; }
fn rt_forever(v) {
  if (!isheap(v)) { return v; }
  var p = v & LOW48; var t = ld8(p); var i = 0; var n = 0;
  if (ld8(p + 2)) { return v; }
  if (t == T_LIST) { st8(p + 2, 1); while (i < LEN(v)) { rt_forever(ITEMS(v)[i]); i += 1; } }
  else if (t == T_DICT) { st8(p + 2, 1); n = dict_n(v); while (i < n) { if (dict_k(v, i) != UNDEF) { rt_forever(dict_v(v, i)); } i += 1; } }
  else if (t == T_SET) { st8(p + 2, 1); }
  else if (t == T_OBJ) { st8(p + 2, 1); var f = p->fields; n = dict_n(f); while (i < n) { if (dict_k(f, i) != UNDEF) { rt_forever(dict_v(f, i)); } i += 1; } }
  return v;
}
fn check_key(k) { if (!isnum(k) && !is_t(k, T_STR) && k != TRUEV && k != FALSEV) { rt_failf("ключом словаря может быть строка, число или логическое значение, а не «%s»", type_name(k), 0, 0); } return k; }
fn rt_dict(n, kv) { var d = dict_new(0); var i = 0; while (i < n) { dict_set(d, check_key(kv[2 * i]), kv[2 * i + 1]); i += 1; } return d; }
fn rt_setlit(n, items) { var d = dict_new(1); var i = 0; while (i < n) { dict_set(d, items[i], TRUEV); i += 1; } return d; }
fn is_int(v) { return isnum(v) && feq(ffloor(v), v) && fne(v, 1e400) && fne(v, -1e400); }
fn index_of(o, iv, n) {
  if (!is_int(iv)) { rt_failf("номер элемента должен быть целым числом, а получено: %s", cshown(iv), 0, 0); }
  var j = iv;
  if (flt(iv, 0.0)) { j = fadd(i2f(n), iv); }
  if (flt(j, 0.0) || fge(j, i2f(n))) {
    var nb[8]; fmt_num(iv, nb);
    var w = "списке"; if (is_t(o, T_STR)) { w = "строке"; }
    rt_failf("в %s нет элемента с номером %s (элементов: %d, нумерация с 0)", w, nb, n);
  }
  return f2i(j);
}
fn rt_idx(o, i) {
  if (is_t(o, T_LIST)) {
    var l = o & LOW48;
    if (isnum(i) && fge(i, 0.0) && flt(i, i2f(l->len))) { var k = f2i(i); if (feq(i2f(k), i)) { return l->items[k]; } }
    return l->items[index_of(o, i, l->len)];
  }
  if (is_t(o, T_STR)) { var j = index_of(o, i, (o & LOW48)->clen); return str_sub(o, j, j + 1); }
  if (is_t(o, T_DICT)) { var r = dict_get(o, i); if (r == UNDEF) { rt_failf("в словаре нет ключа %s", cshown(i), 0, 0); } return r; }
  if (ISNIL(o)) { rt_fail("нельзя взять элемент у «ничего». Подсказка: используй «?.[ ]»"); }
  rt_failf("квадратные скобки можно использовать только со списком, строкой или словарём, а не с «%s»", type_name(o), 0, 0); return 0;
}
fn rt_sidx(o, i) { if (ISNIL(o)) { return NUL; } if (is_t(o, T_DICT)) { var r = dict_get(o, i); if (r == UNDEF) { return NUL; } return r; } return rt_idx(o, i); }
fn rt_setidx(o, i, v) {
  if (is_t(o, T_LIST)) { mutate(o); ITEMS(o)[index_of(o, i, LEN(o))] = v; return 0; }
  if (is_t(o, T_DICT)) { mutate(o); dict_set(o, check_key(i), v); return 0; }
  if (is_t(o, T_STR)) { rt_fail("строку нельзя менять по буквам — создай новую строку"); }
  rt_fail("квадратные скобки можно использовать только со списком или словарём"); return 0;
}
global rt_M[8]; // таблицы функций: 0 строка, 1 список, 2 словарь, 3 множество, 4 число
fn methods_for(o) {
  if (isnum(o)) { return rt_M[4]; }
  var t = vtype(o);
  if (t == T_STR) { return rt_M[0]; } if (t == T_LIST) { return rt_M[1]; } if (t == T_DICT) { return rt_M[2]; } if (t == T_SET) { return rt_M[3]; }
  return UNDEF;
}
fn find_method(o, k) { var t = methods_for(o); if (t == UNDEF) { return UNDEF; } return dict_get(t, k); }
fn method_hint(o, k) { var t = methods_for(o); if (t == UNDEF) { st8(hint_buf, 0); return hint_buf; } var l = list_new(8); rt_tmp[4] = l; keys_into(l, t); var h = hint_names(k, l); rt_tmp[4] = UNDEF; return h; }
fn rt_get(o, k) {
  var ks = S(k); var r = UNDEF;
  if (ISNIL(o)) { rt_failf("нельзя взять «%s» у «ничего». Подсказка: используй «?.», чтобы безопасно пропустить", ks, 0, 0); }
  if (is_t(o, T_CLASS)) { r = cls_lookup(o, 3, k); if (r != UNDEF) { if (is_t(r, T_FN)) { return bind_fn(r, o); } return r; } rt_failf("у класса «%s» нет общего поля или общей функции «%s».%s", cls_name(o), ks, statics_hint(o, ks)); }
  if (k == rt_K[3] || str_eq(k, rt_K[3])) {
    if (is_t(o, T_STR)) { return i2f((o & LOW48)->clen); }
    if (is_t(o, T_LIST)) { return i2f(LEN(o)); }
    if (is_t(o, T_DICT) || is_t(o, T_SET)) { return i2f(dict_live(o)); }
  }
  if (is_t(o, T_DICT)) { r = dict_get(o, k); if (r == UNDEF) { var l = list_new(8); rt_tmp[4] = l; keys_into(l, o); rt_failf("в словаре нет ключа «%s».%s", ks, hint_names(ks, l), 0); } return r; }
  if (is_t(o, T_OBJ)) {
    var ob = o & LOW48;
    r = dict_get(ob->fields, k); if (r != UNDEF) { return r; }
    r = cls_lookup(ob->ocls, 1, k); if (r != UNDEF) { return rt_callf(r, o, 0, 0); }
    r = cls_lookup(ob->ocls, 0, k); if (r != UNDEF) { return bind_fn(r, o); }
    if (cls_lookup(ob->ocls, 2, k) != UNDEF) { return NUL; }
    rt_failf("у «%s» нет поля «%s».%s", cls_name(ob->ocls), ks, obj_hint(o, ks));
  }
  var m = find_method(o, k);
  if (m != UNDEF) { return bind_fn(m, o); }
  rt_failf("у значения типа «%s» нет поля «%s»", type_name(o), ks, 0); return 0;
}
fn rt_sget(o, k) {
  if (ISNIL(o)) { return NUL; }
  if (is_t(o, T_DICT)) { var r = dict_get(o, k); if (r == UNDEF) { return NUL; } return r; }
  if (is_t(o, T_OBJ) && !dict_has((o & LOW48)->fields, k) && !cls_has_any((o & LOW48)->ocls, k)) { return NUL; }
  return rt_get(o, k);
}
fn rt_set(o, k, v) {
  var ks = S(k); var f = UNDEF;
  if (is_t(o, T_DICT)) { mutate(o); dict_set(o, k, v); return 0; }
  if (is_t(o, T_CLASS)) { f = cls_lookup(o, 3, k); if (f == UNDEF || is_t(f, T_FN)) { rt_failf("у класса «%s» нет общего поля «%s»", cls_name(o), ks, 0); } dict_set((o & LOW48)->statics, k, v); return 0; }
  if (is_t(o, T_OBJ)) {
    if (strncmp(ks, "__", 2) == 0) { rt_failf("«%s» — внутреннее имя, его нельзя менять", ks, 0, 0); }
    mutate(o);
    var ob = o & LOW48;
    if (dict_has(ob->fields, k)) { dict_set(ob->fields, k, v); return 0; }
    f = cls_lookup(ob->ocls, 2, k); if (f != UNDEF) { var a[1]; a[0] = v; rt_callf(f, o, 1, a); return 0; }
    if (cls_lookup(ob->ocls, 1, k) != UNDEF) { rt_failf("свойство «%s» только для чтения", ks, 0, 0); }
    dict_set(ob->fields, k, v); return 0;
  }
  if (ISNIL(o)) { rt_failf("нельзя записать «%s» в «ничего». Подсказка: «?.» пропустит запись, если там ничего", ks, 0, 0); }
  rt_failf("нельзя добавить поле «%s» значению типа «%s»", ks, type_name(o), 0); return 0;
}
fn rt_call(o, k, argc, argv) {
  var ks = S(k); var f = UNDEF;
  if (ISNIL(o)) { rt_failf("нельзя вызвать «%s» у «ничего». Подсказка: используй «?.»", ks, 0, 0); }
  if (is_t(o, T_CLASS)) { f = cls_lookup(o, 3, k); if (is_t(f, T_FN)) { return rt_callf(f, o, argc, argv); } rt_failf("у класса «%s» нет общей функции «%s».%s", cls_name(o), ks, statics_hint(o, ks)); }
  if (is_t(o, T_OBJ)) {
    var ob = o & LOW48;
    f = dict_get(ob->fields, k);
    if (f != UNDEF) { if (is_t(f, T_FN) || is_t(f, T_CLASS)) { return rt_callf(f, o, argc, argv); } rt_failf("«%s» у «%s» — это поле, а не функция", ks, cls_name(ob->ocls), 0); }
    f = cls_lookup(ob->ocls, 0, k); if (f != UNDEF) { return rt_callf(f, o, argc, argv); }
    f = cls_lookup(ob->ocls, 1, k); if (f != UNDEF) { var r = rt_callf(f, o, 0, 0); if (is_t(r, T_FN)) { return rt_callf(r, o, argc, argv); } rt_failf("«%s» у «%s» — это поле, а не функция", ks, cls_name(ob->ocls), 0); }
    rt_failf("у «%s» нет функции «%s».%s", cls_name(ob->ocls), ks, obj_hint(o, ks));
  }
  if (is_t(o, T_DICT)) { f = dict_get(o, k); if (is_t(f, T_FN)) { return rt_callf(f, UNDEF, argc, argv); } }
  var m = find_method(o, k);
  if (m == UNDEF) { rt_failf("у значения типа «%s» нет функции «%s».%s", type_name(o), ks, method_hint(o, ks)); }
  return rt_callf(m, o, argc, argv);
}
fn rt_scall(o, k, argc, argv) { if (ISNIL(o)) { return NUL; } return rt_call(o, k, argc, argv); }
fn rt_iter(v) {
  var i = 0; var r = 0;
  if (is_t(v, T_LIST)) { return rt_list(LEN(v), ITEMS(v)); }
  if (is_t(v, T_STR)) {
    var p = v & LOW48; r = list_new(p->clen); var tmp[1];
    while (i < p->blen) { var n = utf8_dec(p->sp, p->blen, i, tmp); list_push(r, strn(p->sp + i, n)); i += n; }
    return r;
  }
  if (is_t(v, T_DICT) || is_t(v, T_SET)) { r = list_new(dict_live(v)); var m = dict_n(v); while (i < m) { var k = dict_k(v, i); if (k != UNDEF) { list_push(r, k); } i += 1; } return r; }
  rt_failf("перебирать «для каждого» можно список, строку, словарь или множество, а не «%s»", type_name(v), 0, 0); return 0;
}
fn pair(a, b) { var x[2]; x[0] = a; x[1] = b; return rt_list(2, x); }
fn rt_pairs(v) {
  var i = 0; var r = 0;
  if (is_t(v, T_DICT)) { r = list_new(dict_live(v)); var m = dict_n(v); while (i < m) { var k = dict_k(v, i); if (k != UNDEF) { list_push(r, pair(k, dict_v(v, i))); } i += 1; } return r; }
  if (is_t(v, T_LIST) && ld8((v & LOW48) + 3)) { return v; }
  if (is_t(v, T_LIST) || is_t(v, T_STR)) { var it = rt_iter(v); rt_tmp[5] = it; r = list_new(LEN(it)); while (i < LEN(it)) { list_push(r, pair(i2f(i), ITEMS(it)[i])); i += 1; } rt_tmp[5] = UNDEF; return r; }
  rt_failf("перебирать пары можно у словаря, списка или строки, а не у «%s»", type_name(v), 0, 0); return 0;
}
fn rt_unpack(v, n) {
  var l = UNDEF;
  if (is_t(v, T_LIST)) { l = v; } else if (is_t(v, T_STR)) { l = rt_iter(v); }
  if (l == UNDEF) { rt_failf("справа от «=» должен быть список из %d значений, а получено: %s", n, type_name(v), 0); }
  if (LEN(l) != n) { rt_failf("слева имён: %d, а справа значений: %d", n, LEN(l), 0); }
  return l;
}
fn rt_count(v) { return ffloor(rt_num(v, "количество повторов")); }
fn rt_step(v) { rt_num(v, "шаг цикла"); if (feq(v, 0.0)) { rt_fail("шаг цикла не может быть нулём"); } return v; }
fn rt_missing(name) { rt_failf("не передано значение для параметра «%s»", name, 0, 0); return 0; }
fn rt_enum(n, names, vals) {
  var m = dict_new(0); var last = -1.0; var i = 0;
  while (i < n) { var x = vals[i]; if (x == UNDEF) { x = fadd(last, 1.0); } if (isnum(x)) { last = x; } dict_set(m, names[i], x); i += 1; }
  st8((m & LOW48) + 2, 1); return m;
}
