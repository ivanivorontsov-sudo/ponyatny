    var i = 0; while (i < n) { if (ld8(buf + i) == ',') { st8(buf + i, '.'); break; } i += 1; }
    var r = parse_js_number(buf, n);
    free(buf);
    if (r == UNDEF) { rt_failf("не получается превратить «%s» в число", S(v), 0, 0); }
    return r;
  }
  rt_failf("не получается превратить «%s» в число", type_name(v), 0, 0); return 0;
}
fn digit_val(c) { if (c >= '0' && c <= '9') { return c - '0'; } if (c >= 'a' && c <= 'z') { return c - 'a' + 10; } if (c >= 'A' && c <= 'Z') { return c - 'A' + 10; } return 99; }
// как Number(текст) в JavaScript; UNDEF — не число
fn parse_js_number(s, n) {
  if (n == 0) { return UNDEF; }
  var i = 0; var neg = 0;
  if (n > 2 && ld8(s) == '0') {
    var c1 = ld8(s + 1); var base = 0;
    if (c1 == 'x' || c1 == 'X') { base = 16; } if (c1 == 'o' || c1 == 'O') { base = 8; } if (c1 == 'b' || c1 == 'B') { base = 2; }
    if (base) {
      var acc = 0.0; i = 2;
      while (i < n) { var dv = digit_val(ld8(s + i)); if (dv >= base) { return UNDEF; } acc = fadd(fmul(acc, i2f(base)), i2f(dv)); i += 1; }
      return acc;
    }
  }
  if (ld8(s) == '+' || ld8(s) == '-') { i = 1; }
  if (strcmp(s + i, "Infinity") == 0) { if (ld8(s) == '-') { return -1e400; } return 1e400; }
  var digits = 0; var j = i;
  while (j < n && ld8(s + j) >= '0' && ld8(s + j) <= '9') { j += 1; digits += 1; }
  if (j < n && ld8(s + j) == '.') { j += 1; while (j < n && ld8(s + j) >= '0' && ld8(s + j) <= '9') { j += 1; digits += 1; } }
  if (digits == 0) { return UNDEF; }
  if (j < n && (ld8(s + j) == 'e' || ld8(s + j) == 'E')) {
    j += 1; if (j < n && (ld8(s + j) == '+' || ld8(s + j) == '-')) { j += 1; }
    var ed = 0; while (j < n && ld8(s + j) >= '0' && ld8(s + j) <= '9') { j += 1; ed += 1; }
    if (ed == 0) { return UNDEF; }
  }
  if (j != n) { return UNDEF; }
  return strtod(s, 0);
}
