fn rt_integral(f, a, b, n, h) {
  if (!is_t(f, T_FN)) { rt_fail("интегрировать можно только функцию"); }
  rt_num(a, "начало отрезка"); rt_num(b, "конец отрезка");
  var N = 1000;
  if (!ISNIL(n)) { N = f2i(js_round(rt_num(n, "число шагов"))); }
  else if (!ISNIL(h)) { rt_num(h, "шаг"); if (fle(h, 0.0)) { rt_fail("шаг интеграла должен быть больше нуля"); } N = f2i(js_round(fdiv(fsub(b, a) & 0x7FFFFFFFFFFFFFFF, h))); }
  if (N < 2) { N = 2; }
  if (N % 2) { N += 1; }
  if (N > 10000000) { rt_fail("слишком много шагов в интеграле (больше 10 000 000)"); }
  var dx = fdiv(fsub(b, a), i2f(N)); var sum = 0.0; var i = 0;
  while (i <= N) {
    var y = call1(f, fadd(a, fmul(i2f(i), dx)));
    if (!isnum(y)) { rt_failf("под интегралом должно получаться число, а получено: %s", cshow(y), 0, 0); }
    if (i == 0 || i == N) { sum = fadd(sum, y); } else if (i % 2) { sum = fadd(sum, fmul(4.0, y)); } else { sum = fadd(sum, fmul(2.0, y)); }
    i += 1;
  }
  var r = fdiv(fmul(sum, dx), 3.0);
  if (fne(r, r) || feq(r, 1e400) || feq(r, -1e400)) { return r; }
  var buf[8]; snprintf(buf, 60, "%.11e", F(r)); return strtod(buf, 0);
}
