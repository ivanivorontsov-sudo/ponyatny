    var j = i + 1; var left = 0; var width = 0; var prec = -1;
    if (j < n && ld8(s + j) == '-') { left = 1; j += 1; }
    while (j < n && ld8(s + j) >= '0' && ld8(s + j) <= '9') { width = width * 10 + ld8(s + j) - '0'; j += 1; }
    if (j < n && ld8(s + j) == '.' && j + 1 < n && ld8(s + j + 1) >= '0' && ld8(s + j + 1) <= '9') { j += 1; prec = 0; while (j < n && ld8(s + j) >= '0' && ld8(s + j) <= '9') { prec = prec * 10 + ld8(s + j) - '0'; j += 1; } }
    var spec = 0; if (j < n) { spec = ld8(s + j); }
