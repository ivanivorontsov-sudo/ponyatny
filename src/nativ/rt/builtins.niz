// toFixed из JavaScript: половина округляется вверх (от нуля по модулю)
fn to_fixed(x, f, out) {
  var buf[16]; var neg = flt(x, 0.0); var ax = x & 0x7FFFFFFFFFFFFFFF;
  if (fge(ax, 1e21)) { js_num(x, out); return 0; }
