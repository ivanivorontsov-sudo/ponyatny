# Инженерный калькулятор «Логарифмическая линейка 3000» на языке «Понятный» 2.6

# Базовая четвёрка для совместимости с графическим шаблоном APK
функция сложить(а, б)
    верни а + б
конец

функция вычесть(а, б)
    верни а - б
конец

функция умножить(а, б)
    верни а * б
конец

функция разделить(а, б)
    если б == 0 то
        верни "Деление на ноль запрещено Женевской конвенцией"
    конец
    верни а / б
конец

# --- Математическое ядро ---

функция посчитать_факториал(н)
    если н < 0 или н != вниз(н) то
        брось "Факториал берётся только от целых неотрицательных чисел!"
    конец
    если н > 170 то
        брось "Слишком большое число: у калькулятора задымится процессор"
    конец
    пусть итог = 1
    пусть счетчик = 2
    пока счетчик <= н
        итог *= счетчик
        счетчик += 1
    конец
    верни итог
конец

функция это_цифра(с)
    верни "0123456789".содержит(с)
конец

функция это_буква(с)
    пусть алфавит = "абвгдеёжзийклмнопрстуфхцчшщъыьэюяАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    верни алфавит.содержит(с)
конец

# --- Лексический анализатор (разбивает строку на токены) ---

функция разбить_на_токены(текст)
    пусть символы = текст.символы()
    пусть токены = []
    пусть индекс = 0

    пока индекс < символы.длина
        пусть т = символы[индекс]

        если т == " " или т == "\t" то
            индекс += 1
            дальше
        конец

        # Считываем числа (поддерживаем и точку, и запятую в дроби)
        если это_цифра(т) или т == "." или т == "," то
            пусть буфер = ""
            пусть точек = 0
            пока индекс < символы.длина
                пусть тек_с = символы[индекс]
                если это_цифра(тек_с) то
                    буфер += тек_с
                    индекс += 1
                иначе если тек_с == "." или тек_с == "," то
                    точек += 1
                    если точек > 1 то
                        брось "В одном числе не может быть две десятичные точки!"
                    конец
                    буфер += "."
                    индекс += 1
                иначе
                    стоп
                конец
            конец
            токены.добавь({"вид": "число", "знач": число(буфер)})
            дальше
        конец

        # Считываем имена функций и констант
        если это_буква(т) то
            пусть слово = ""
            пока индекс < символы.длина
                пусть тек_с = символы[индекс]
                если это_буква(тек_с) или это_цифра(тек_с) то
                    слово += тек_с
                    индекс += 1
                иначе
                    стоп
                конец
            конец
            токены.добавь({"вид": "имя", "знач": слово.маленькими()})
            дальше
        конец

        # Операторы и скобки
        если "+-*/%^()!;".содержит(т) то
            токены.добавь({"вид": "знак", "знач": т})
            индекс += 1
            дальше
        конец

        брось "Неизвестный символ в выражении: «{т}»"
    конец

    токены.добавь({"вид": "конец", "знач": ""})
    верни токены
конец

# --- Класс инженерного калькулятора с рекурсивным парсером ---

класс ИнженерныйКалькулятор
    пусть градусы = истина
    пусть память_м = 0
    пусть ответ_анс = 0
    пусть журнал = []
    пусть токены = []
    пусть позиция = 0

    функция текущий()
        верни это.токены[это.позиция]
    конец

    функция съесть(ожидаемый_знак)
        пусть т = это.текущий()
        если т["вид"] != "знак" или т["знач"] != ожидаемый_знак то
            брось "Ожидался символ «{ожидаемый_знак}», а встретилось «{т["знач"]}»"
        конец
        это.позиция += 1
    конец

    функция в_радианы(угол)
        если это.градусы то
            верни угол * ПИ / 180
        конец
        верни угол
    конец

    функция из_радиан(рад)
        если это.градусы то
            верни рад * 180 / ПИ
        конец
        верни рад
    конец

    функция вызвать_функцию(имя_ф, арг)
        если арг.длина == 0 то
            брось "Функции «{имя_ф}» нужен хотя бы один аргумент в скобках"
        конец
        пусть х = арг[0]

        выбор имя_ф
            вариант "синус", "sin"
                верни синус(это.в_радианы(х))
            вариант "косинус", "cos"
                верни косинус(это.в_радианы(х))
            вариант "тангенс", "tg", "tan"
                верни тангенс(это.в_радианы(х))
            вариант "арктангенс", "arctg", "atan"
                верни это.из_радиан(арктангенс(х))
            вариант "корень", "sqrt"
                если х < 0 то
                    брось "Корень из отрицательного числа в действительных числах не берётся!"
                конец
                верни корень(х)
            вариант "модуль", "abs"
                верни модуль(х)
            вариант "лн", "ln"
                если х <= 0 то
                    брось "Логарифм существует только для положительных чисел!"
                конец
                верни логарифм(х)
            вариант "лог", "логарифм", "log"
                если х <= 0 то
                    брось "Логарифм существует только для положительных чисел!"
                конец
                если арг.длина >= 2 то
                    пусть осн = арг[1]
                    если осн <= 0 или осн == 1 то
                        брось "Некорректное основание логарифма!"
                    конец
                    верни логарифм(х, осн)
                конец
                верни логарифм(х, 10)
            вариант "експ", "экспонента", "exp"
                верни экспонента(х)
            вариант "округли", "round"
                пусть знаков = если арг.длина >= 2 то целое(арг[1]) иначе 0
                верни округли(х, знаков)
            вариант "вниз", "floor"
                верни вниз(х)
            вариант "вверх", "ceil"
                верни вверх(х)
            вариант "макс", "max"
                если арг.длина < 2 то
                    брось "Для макс(а; б) нужно два числа через точку с запятой"
                конец
                верни макс(х, арг[1])
            вариант "мин", "min"
                если арг.длина < 2 то
                    брось "Для мин(а; б) нужно два числа через точку с запятой"
                конец
                верни мин(х, арг[1])
            иначе
                брось "Неизвестная функция «{имя_ф}»"
        конец
    конец

    # Уровень 1: сложение и вычитание
    функция разбор_суммы()
        пусть левое = это.разбор_произведения()
        пока истина
            пусть т = это.текущий()
            если т["вид"] == "знак" и (т["знач"] == "+" или т["знач"] == "-") то
                это.позиция += 1
                пусть правое = это.разбор_произведения()
                если т["знач"] == "+" то
                    левое = левое + правое
                иначе
                    левое = левое - правое
                конец
            иначе
                стоп
            конец
        конец
        верни левое
    конец

    # Уровень 2: умножение, деление, остаток
    функция разбор_произведения()
        пусть левое = это.разбор_степени()
        пока истина
            пусть т = это.текущий()
            если т["вид"] == "знак" и "*/%".содержит(т["знач"]) то
                это.позиция += 1
                пусть правое = это.разбор_степени()
                если т["знач"] == "*" то
                    левое = левое * правое
                иначе если т["знач"] == "/" то
                    если правое == 0 то
                        брось "Деление на ноль! Вселенная чуть не схлопнулась."
                    конец
                    левое = левое / правое
                иначе
                    если правое == 0 то
                        брось "Остаток от деления на ноль не определён"
                    конец
                    левое = левое % правое
                конец
            иначе
                стоп
            конец
        конец
        верни левое
    конец

    # Уровень 3: возведение в степень (правоассоциативное: 2^3^2 = 2^9)
    функция разбор_степени()
        пусть основание = это.разбор_унарного()
        пусть т = это.текущий()
        если т["вид"] == "знак" и т["знач"] == "^" то
            это.позиция += 1
            пусть показатель = это.разбор_степени()
            верни основание ^ показатель
        конец
        верни основание
    конец

    # Уровень 4: унарный плюс и минус (-5, +3)
    функция разбор_унарного()
        пусть т = это.текущий()
        если т["вид"] == "знак" и (т["знач"] == "-" или т["знач"] == "+") то
            это.позиция += 1
            пусть значение = это.разбор_унарного()
            верни если т["знач"] == "-" то -значение иначе значение
        конец
        верни это.разбор_постфикса()
    конец

    # Уровень 5: факториал (5!)
    функция разбор_постфикса()
        пусть значение = это.разбор_первичного()
        пока истина
            пусть т = это.текущий()
            если т["вид"] == "знак" и т["знач"] == "!" то
                это.позиция += 1
                значение = посчитать_факториал(значение)
            иначе
                стоп
            конец
        конец
        верни значение
    конец

    # Уровень 6: числа, скобки, константы и вызовы функций
    функция разбор_первичного()
        пусть т = это.текущий()

        если т["вид"] == "число" то
            это.позиция += 1
            верни т["знач"]
        конец

        если т["вид"] == "знак" и т["знач"] == "(" то
            это.позиция += 1
            пусть внутри = это.разбор_суммы()
            это.съесть(")")
            верни внутри
        конец

        если т["вид"] == "имя" то
            пусть имя_узла = т["знач"]
            это.позиция += 1

            # Если дальше идёт открывающая скобка — это функция
            пусть след = это.текущий()
            если след["вид"] == "знак" и след["знач"] == "(" то
                это.позиция += 1
                пусть арг = []
                если это.текущий()["вид"] != "знак" или это.текущий()["знач"] != ")" то
                    пока истина
                        арг.добавь(это.разбор_суммы())
                        если это.текущий()["вид"] == "знак" и это.текущий()["знач"] == ";" то
                            это.позиция += 1
                        иначе
                            стоп
                        конец
                    конец
                конец
                это.съесть(")")
                верни это.вызвать_функцию(имя_узла, арг)
            конец

            # Иначе это константа или переменная калькулятора
            выбор имя_узла
                вариант "пи", "pi"
                    верни ПИ
                вариант "е", "e"
                    верни экспонента(1)
                вариант "анс", "ans"
                    верни это.ответ_анс
                вариант "м", "m"
                    верни это.память_м
                иначе
                    брось "Неизвестная константа «{имя_узла}». Доступны: пи, е, анс, м"
            конец
        конец

        брось "Неожиданный фрагмент выражения: «{т["знач"]}»"
    конец

    функция вычислить(строка_формулы)
        это.токены = разбить_на_токены(строка_формулы)
        это.позиция = 0
        пусть итог = это.разбор_суммы()
        если это.текущий()["вид"] != "конец" то
            брось "Лишние символы в конце: «{это.текущий()["знач"]}»"
        конец
        итог = округли(итог, 10)
        это.ответ_анс = итог
        это.журнал.добавь("{строка_формулы} = {итог}")
        верни итог
    конец
конец

# --- Интерактивный пульт управления ---

функция запустить_калькулятор()
    пусть кальк = ИнженерныйКалькулятор()

    пиши "===================================================="
    пиши "  ИНЖЕНЕРНЫЙ КАЛЬКУЛЯТОР «ЛОГАРИФМИЧЕСКАЯ ЛИНЕЙКА»  "
    пиши "===================================================="
    пиши "Примеры формул:"
    пиши "  2 + 2 * 2^10 - корень(144) + 5!"
    пиши "  синус(30) + косинус(60) + логарифм(8; 2)"
    пиши "  анс * пи + м"
    пиши "\nКоманды:"
    пиши "  град / рад  — переключить градусы и радианы"
    пиши "  м+ / м- / мс — добавить в память / вычесть / очистить"
    пиши "  история     — показать журнал расчётов"
    пиши "  выход       — закрыть калькулятор"

    пока истина
        пусть режим = если кальк.градусы то "ГРАД" иначе "РАД"
        пиши "\n[{режим} | Память M = {кальк.память_м} | АНС = {кальк.ответ_анс}]"
        пусть ввод = спроси("Формула > ").обрезать()

        если ввод == "" то
            дальше
        конец

        пусть команда = ввод.маленькими()

        если команда == "выход" или команда == "стоп" то
            пиши "Калькулятор ушёл в спящий режим. До связи!"
            стоп
        конец

        если команда == "град" то
            кальк.градусы = истина
            пиши ">> Режим углов: ГРАДУСЫ"
            дальше
        конец

        если команда == "рад" то
            кальк.градусы = ложь
            пиши ">> Режим углов: РАДИАНЫ"
            дальше
        конец

        если команда == "м+" или команда == "m+" то
            кальк.память_м += кальк.ответ_анс
            пиши ">> В память добавлено {кальк.ответ_анс}. Теперь M = {кальк.память_м}"
            дальше
        конец

        если команда == "м-" или команда == "m-" то
            кальк.память_м -= кальк.ответ_анс
            пиши ">> Из памяти вычтено {кальк.ответ_анс}. Теперь M = {кальк.память_м}"
            дальше
        конец

        если команда == "мс" или команда == "mc" то
            кальк.память_м = 0
            пиши ">> Память очищена (M = 0)"
            дальше
        конец

        если команда == "история" то
            если кальк.журнал.пусто() то
                пиши ">> История пока пуста — посчитайте хоть что-нибудь!"
            иначе
                пиши ">> Журнал вычислений:"
                для каждого номер, запись из нумеруй(кальк.журнал)
                    пиши "   {номер + 1}) {запись}"
                конец
            конец
            дальше
        конец

        попробуй
            пусть результат = кальк.вычислить(ввод)
            пиши ">> Ответ: {результат}"
        если ошибка как е
            пиши ">> Ошибка расчёта: {е}"
        конец
    конец
конец

запустить_калькулятор()
