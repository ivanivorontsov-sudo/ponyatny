напиши факториал(5), нод(12, 18), нок(4, 6), простое(97), среднее([1, 2, 3, 4]), медиана([5, 1, 3]), медиана([1, 2, 3, 4])
напиши "[" + дополни_слева(7, 3, "0") + "]", "[" + по_центру("ab", 6) + "]", слова("  раз два  три "), сколько_раз("абаба", "ба"), это_число("3,5"), это_число("x"), палиндром("А роза упала на лапу Азора")
напиши уникальные([1, 2, 2, 3, 1]), подсчитай(["а", "б", "а"]), разбей([1, 2, 3, 4, 5], 2), соедини_пары([1, 2], ["a", "b"]), наибольший_по(["кот", "бегемот"], x => длина(x))
напиши длина(перемешай([1, 2, 3, 4])), кубик() >= 1, длина(пароль(12)), случайный_элемент(["x"])
напиши длина(сегодня()), длина(сейчас()), день_недели() в НАЗВАНИЯ_ДНЕЙ, високосный(2024), високосный(1900), дней_в_месяце(2, 2024)
пусть с = Секундомер()
подожди(0.05)
напиши с.прошло() >= 0.04
рамка("Привет\nмир")
напиши полоска(0.5, 10)
таблица(["Имя", "Балл"], [["Оля", 5], ["Иван", 4]])
напиши деньги(1234567.5), формат_числа(-0.004, 2), формат_числа(3.14159, 3)
запиши_строки("x.txt", ["a", "b"])
допиши_строку("x.txt", "c")
напиши прочитай_строки("x.txt")
сохрани_словарь("d.txt", {"имя": "Оля", "лет": 12})
напиши загрузи_словарь("d.txt")
напиши синус(в_радианы(90)), вниз(2.7), вверх(2.1), округли(логарифм(8, 2))
пусть н = спроси_число("Число:", 1, 10)
напиши "получил", н
