# Оконный интерфейс: поля ввода, кнопки и надписи (песочница и «Строка»)
пиши "Введите два числа и нажмите кнопку"
пусть первое = поле_ввода("Первое число")
пусть второе = поле_ввода("Второе число")
пусть итог = надпись("Результат появится здесь")

функция посчитай(знак)
    попробуй
        пусть а = число(значение_поля(первое))
        пусть б = число(значение_поля(второе))
        пусть ответ = 0
        если знак == "+" то
            ответ = а + б
        иначе если знак == "-" то
            ответ = а - б
        иначе если знак == "×" то
            ответ = а * б
        иначе если б == 0 то
            ответ = "на ноль делить нельзя"
        иначе
            ответ = а / б
        конец
        задай_текст(итог, "= {ответ}")
    если ошибка как е
        задай_текст(итог, "Ошибка: {е}")
    конец
конец

кнопка("+", функция() => посчитай("+"))
кнопка("−", функция() => посчитай("-"))
кнопка("×", функция() => посчитай("×"))
кнопка("÷", функция() => посчитай("÷"))
