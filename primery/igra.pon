# Игра «Пинг-понг»: окно, кадры, клавиши (стрелки) и счёт. Запускается в песочнице и в «Строке».
подключи "стд/игра"

окно("Пинг-понг", 480, 320)
пусть ракетка = Спрайт(200, 300, 80, 10, "голубой")
пусть мяч = Спрайт(230, 40, 12, 12, "жёлтый")
мяч.скорость_x = 160
мяч.скорость_y = 170
пусть счёт = Счёт()

функция кадр(дт)
    если клавиша("влево") то
        ракетка.x -= 320 * дт
    конец
    если клавиша("вправо") то
        ракетка.x += 320 * дт
    конец
    ракетка.держи_в_границах(480, 320)
    мяч.двигай(дт)
    если мяч.x < 0 или мяч.x + мяч.ширина > 480 то
        мяч.скорость_x = -мяч.скорость_x
        мяч.x = ограничь_значение(мяч.x, 0, 480 - мяч.ширина)
    конец
    если мяч.y < 0 то
        мяч.скорость_y = модуль(мяч.скорость_y)
    конец
    если мяч.касается(ракетка) и мяч.скорость_y > 0 то
        мяч.скорость_y = -мяч.скорость_y * 1.05
        счёт.добавь_очки()
        пищи(660, 60)
    конец
    если мяч.y > 320 то
        если счёт.потеряй_жизнь() то
            залей("чёрный")
            рисуй_текст(150, 140, "Игра окончена! Очки: {счёт.очки}", "красный", 20)
            стоп_игра()
            верни ничего
        конец
        мяч.x = 230
        мяч.y = 40
        мяч.скорость_y = 170
    конец
    залей("#101820")
    ракетка.нарисуй()
    круг(мяч.центр_x(), мяч.центр_y(), 6, мяч.цвет)
    счёт.нарисуй()
конец

пиши "Управление: стрелки ← и →. Щёлкни по полю, чтобы оно получило клавиши."
каждый_кадр(кадр)
