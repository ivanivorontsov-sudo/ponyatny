# Квантовые вычисления: настоящий симулятор кубитов (стд/квант)
подключи "стд/квант"

пиши "1) Запутанная пара Белла:"
пусть пара = состояние_белла()
пиши "   ", пара.состояние()
пиши "   вероятности:", пара.вероятности()
пиши "   1000 замеров:", пара.замеры(1000)

пиши "2) Суперпозиция одного кубита после вентиля Адамара:"
пусть кубит = КвантовыйРегистр(1)
кубит.адамар(0)
пиши "   ", кубит.состояние(), "— вероятность единицы", кубит.вероятность_единицы(0)

пиши "3) Алгоритм Гровера ищет 11 среди 16 чисел:"
пусть поиск = гровер(4, 11)
пиши "   вероятность найти |1011⟩ =", округли(поиск.вероятности()["|1011⟩"], 4)

пиши "4) Алгоритм Дойча — Йожи за один запрос:"
пиши "   f(x) = 0 →", дойч_йожа(3, x => 0)
пиши "   f(x) = x % 2 →", дойч_йожа(3, x => x % 2)

пиши "5) Квантовое преобразование Фурье числа 1 на двух кубитах:"
пусть ф = КвантовыйРегистр(2)
ф.паули_x(0)
квантовое_фурье(ф)
пиши "   ", ф.состояние()
