# Классы и наследование
класс Животное
    пусть имя = "безымянное"
    функция создать(имя, возраст = 1)
        это.имя = имя
        это.возраст = возраст
    конец
    функция голос()
        верни "..."
    конец
    функция строкой()
        верни "{это.имя} ({это.возраст} г.) говорит «{это.голос()}»"
    конец
конец

класс Кот наследует Животное
    функция голос()
        верни "мяу"
    конец
конец

класс Собака наследует Животное
    функция голос()
        верни "гав"
    конец
    функция подрасти()
        это.возраст += 1
    конец
конец

пусть звери = [Кот("Барсик", 3), Собака("Шарик"), Животное("Ёжик", 2)]
звери[1].подрасти()
для каждого з из звери
    пиши з
конец

структура Точка(x, y = 0)
пусть т = Точка(3, 4)
пиши "Расстояние до {т.x}, {т.y}:", корень(т.x ^ 2 + т.y ^ 2)
