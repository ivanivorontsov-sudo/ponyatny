константа МАКС = 10
пусть навсегда цвета = ["красный", "зелёный"]
функция привет(имя, восклицание = "!")
    верни "Привет, {имя}{восклицание}"
конец
напиши привет("Ваня"), привет("мир", "?")
функция факториал(н: число) -> число
    если н <= 1 то
        верни 1
    конец
    верни н * факториал(н - 1)
конец
напиши "5! = {факториал(5)}"
для i от 1 до МАКС шаг 3
    если i == 7 то
        дальше
    конец
    напиши i
конец
для i от 3 до 1
    напиши "вниз", i
конец
пусть оценки = {"Ваня": 5, Петя: 4}
оценки["Маша"] = 3
для каждого имя, балл из оценки
    напиши "{имя}: {балл}"
конец
напиши оценки.ключи(), оценки.длина, "Петя" в оценки
пусть текст = "  Привет МИР  "
напиши текст затем обрезать затем маленькими
напиши текст |> обрезать |> длина
попробуй
    напиши 1 / 0
если ошибка как е
    напиши "Поймал:", е
конец
попробуй
    брось "своя беда"
если ошибка как е
    напиши "Поймал:", е
наконец
    напиши "наконец"
конец
функция размер(n)
    выбор n
        вариант 0
            верни "ноль"
        вариант 1, 2, 3
            верни "мало"
        когда x если x > 100 то
            верни "огромное"
        иначе
            верни "средне"
    конец
конец
напиши размер(0), размер(2), размер(500), размер(50)
класс Животное
    пусть имя = "?"
    функция создать(имя)
        это.имя = имя
    конец
    функция голос()
        верни "..."
    конец
    функция строкой()
        верни "{это.имя} говорит {себя.голос()}"
    конец
конец
класс Кот наследует Животное
    функция голос()
        верни "мяу"
    конец
конец
пусть к = Кот("Барсик")
напиши к
напиши новый Животное("Тень")
структура Точка(x, y = 0)
пусть т = Точка(3)
т.y = 4
напиши т, корень(т.x ^ 2 + т.y ^ 2)
пусть удвоить = функция(x) => x * 2
напиши [1, 2, 3].преобразуй(удвоить), [1, 2, 3, 4].отфильтруй(x => x % 2 == 0)
напиши [5, 3, 9].свернуть(функция(а, б) => а + б, 0)
пусть покупатель = ничего
напиши покупатель?.заказ
покупатель?.заказ = 5
пусть п2 = {заказ: {номер: 7}}
напиши п2?.заказ?.номер
пусть счёт = 0
пока истина
    счёт += 1
    если счёт >= 3 то
        стоп
    конец
конец
напиши счёт, тип(счёт), тип(цвета), тип(к)
попробуй
    добавь(цвета, "синий")
если ошибка как е
    напиши е
конец
напиши если счёт > 2 то "много" иначе "мало"
