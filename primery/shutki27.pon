# Шуточные операторы 2.7 и приколы из советских фильмов. Всё детерминировано: никаких монеток.
функция рискованная()
    авось_сработает
        пусть х = 1 / 0
        пиши "сюда не дойдём"
    конец
    верни 1
конец
пиши "авось_сработает вернул", рискованная()

пиши приложить_подорожник(1 / 0), "/", приложить_подорожник(ничего), "/", приложить_подорожник(7)

сделать_вид_что_так_и_задумано
    замуровали_демоны("кнопка не нажимается")
конец

интеграл х от 0 до 1
    х * х
конец
пиши "площадь под параболой от 0 до 1 =", площадь

памятник ВЫСОТА = 15
пиши "Кто ж его посадит? Он же памятник! Высота:", ВЫСОТА
пиши короче_склифосовский("Короче, Склифосовский, давай уже к делу переходи", 20)
пиши "Брюки превращаются:", брюки_превращаются("42") + 1
пиши "Крылатые качели:", крылатые_качели([1, 2, 3])
пиши "Рэсси нашла кость на месте", рэсси(["мяч", "кость"], "кость")
пиши электроник(x => x * 2, 21)
для каждого н из [1, 2, 3, 4]
    если н == 3 то
        птичку_жалко
    конец
    пиши "тост", н
конец
ы
чтоб_никто_не_догадался
    пиши "этого никто не увидит"
конец
класс Царь
    пусть имя = "Иван Васильевич"
конец
миелофон(Царь())
